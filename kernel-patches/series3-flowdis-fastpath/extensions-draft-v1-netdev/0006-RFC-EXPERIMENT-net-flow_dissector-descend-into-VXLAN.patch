From 207e5b1032775135700152b9f88acd6422f798ab Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Sun, 14 Jun 2026 22:56:04 -0700
Subject: [PATCH 6/6] RFC EXPERIMENT: net: flow_dissector: descend into VXLAN
 inner flow (v1-netdev)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

VXLAN-inner descent on the v1-netdev parent — adds inner-flow
hashing path in flow_dissect_fast_ipv4 when UDP dst is
IANA_VXLAN_UDP_PORT. NOT byte-identical with the slow path; see
the cover letter for the open design questions.

Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 net/core/flow_dissector.c | 46 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)

diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index d2cc7b60c6fa..547554a01145 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -13,6 +13,7 @@
 #include <net/gre.h>
 #include <net/pptp.h>
 #include <net/tipc.h>
+#include <net/vxlan.h>
 #include <linux/igmp.h>
 #include <linux/icmp.h>
 #include <linux/sctp.h>
@@ -1132,6 +1133,51 @@ static bool flow_dissect_fast_ipv4(const struct sk_buff *skb,
 		key_ports->ports = *ports;
 	}
 
+	/* EXPERIMENT: descend into VXLAN inner flow for hashing.
+	 * NOT byte-identical with the slow path — the standard
+	 * flow_keys_dissector stops at outer UDP today. Descending is a
+	 * behaviour change. Gated by the same parent fastpath sysctl as
+	 * the byte-identical extensions. See the cover letter.
+	 */
+	if (iph->protocol == IPPROTO_UDP &&
+	    hlen - thoff >= (int)(sizeof(struct udphdr) +
+				  sizeof(struct vxlanhdr) +
+				  ETH_HLEN)) {
+		const __be16 *udp_ports = (const __be16 *)
+			((const u8 *)data + thoff);
+
+		if (udp_ports[1] == htons(IANA_VXLAN_UDP_PORT)) {
+			const struct ethhdr *inner_eth =
+				(const struct ethhdr *)
+				((const u8 *)data + thoff +
+				 sizeof(struct udphdr) +
+				 sizeof(struct vxlanhdr));
+			__be16 inner_proto = inner_eth->h_proto;
+			int inner_nhoff = thoff +
+				sizeof(struct udphdr) +
+				sizeof(struct vxlanhdr) + ETH_HLEN;
+
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_CONTROL)) {
+				key_control = skb_flow_dissector_target(flow_dissector,
+									FLOW_DISSECTOR_KEY_CONTROL,
+									target_container);
+				key_control->flags |= FLOW_DIS_ENCAPSULATION;
+			}
+
+			switch (inner_proto) {
+			case htons(ETH_P_IP):
+				return flow_dissect_fast_ipv4(skb, flow_dissector,
+							      target_container, data,
+							      inner_nhoff, hlen);
+			case htons(ETH_P_IPV6):
+				return flow_dissect_fast_ipv6(skb, flow_dissector,
+							      target_container, data,
+							      inner_nhoff, hlen);
+			}
+		}
+	}
+
 	return true;
 }
 
