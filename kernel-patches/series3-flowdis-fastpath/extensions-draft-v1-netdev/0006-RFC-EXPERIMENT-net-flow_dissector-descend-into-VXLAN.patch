From ca4a35ec15f6837e61289912fdb94762f3893a04 Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Sun, 14 Jun 2026 20:27:21 -0700
Subject: [PATCH 6/6] RFC EXPERIMENT: net: flow_dissector: descend into VXLAN
 inner flow (v1-netdev)

THIS IS A BEHAVIOUR CHANGE, not a byte-identical fast-path.

Today's flow_keys_dissector stops at outer UDP for VXLAN; this patch
extends flow_dissect_fast_ipv4 to detect UDP/IANA_VXLAN_UDP_PORT
(4789) and descend into the inner Eth + IPv4/IPv6 for hashing.

Open questions (cover letter): separate sysctl vs piggy-back, slow-
path symmetry, configurable VXLAN port. Not landable as-is.

Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 net/core/flow_dissector.c | 47 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index 102b82ec5891..88d7c7215111 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -13,6 +13,7 @@
 #include <net/gre.h>
 #include <net/pptp.h>
 #include <net/tipc.h>
+#include <net/vxlan.h>
 #include <linux/igmp.h>
 #include <linux/icmp.h>
 #include <linux/sctp.h>
@@ -1115,6 +1116,52 @@ static bool flow_dissect_fast_ipv4(const struct sk_buff *skb,
 		key_ports->ports = *ports;
 	}
 
+	/* EXPERIMENT: descend into VXLAN inner flow for hashing.
+	 * NOT byte-identical with the existing slow path — the standard
+	 * flow_keys_dissector stops at outer UDP today. Descending is a
+	 * behaviour change with operator-visible impact. Gated by the
+	 * same parent fastpath sysctl as the byte-identical extensions
+	 * above. See the cover letter; not landable as-is.
+	 */
+	if (iph->protocol == IPPROTO_UDP &&
+	    hlen - thoff >= (int)(sizeof(struct udphdr) +
+				  sizeof(struct vxlanhdr) +
+				  ETH_HLEN)) {
+		const __be16 *udp_ports = (const __be16 *)
+			((const u8 *)data + thoff);
+
+		if (udp_ports[1] == htons(IANA_VXLAN_UDP_PORT)) {
+			const struct ethhdr *inner_eth =
+				(const struct ethhdr *)
+				((const u8 *)data + thoff +
+				 sizeof(struct udphdr) +
+				 sizeof(struct vxlanhdr));
+			__be16 inner_proto = inner_eth->h_proto;
+			int inner_nhoff = thoff +
+				sizeof(struct udphdr) +
+				sizeof(struct vxlanhdr) + ETH_HLEN;
+
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_CONTROL)) {
+				key_control = skb_flow_dissector_target(flow_dissector,
+									FLOW_DISSECTOR_KEY_CONTROL,
+									target_container);
+				key_control->flags |= FLOW_DIS_ENCAPSULATION;
+			}
+
+			switch (inner_proto) {
+			case htons(ETH_P_IP):
+				return flow_dissect_fast_ipv4(skb, flow_dissector,
+							      target_container, data,
+							      inner_nhoff, hlen);
+			case htons(ETH_P_IPV6):
+				return flow_dissect_fast_ipv6(skb, flow_dissector,
+							      target_container, data,
+							      inner_nhoff, hlen);
+			}
+		}
+	}
+
 	return true;
 }
 
