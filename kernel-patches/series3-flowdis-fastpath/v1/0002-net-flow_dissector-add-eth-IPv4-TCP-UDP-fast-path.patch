From c59233bf2874284e847f6b9b1a5b11948152339b Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Wed, 27 May 2026 14:59:41 -0700
Subject: [PATCH RFC 2/3] net: flow_dissector: add eth+IPv4+{TCP,UDP} fast-path

Plug the IPv4 stub from the framework patch with a straight-line
extractor for the common-case packet shape.

The fast-path matches a narrow shape:

- 20-byte IPv4 header. Reject IP options by checking the first
  byte is 0x45 (version 4, IHL 5).
- Not a fragment. Reject MF or non-zero fragment offset.
- TCP or UDP only. Reject other transport protocols.

On a match the fast-path writes the same key slots the slow path
would write for the standard dissectors:

- key_control: addr_type, thoff, flags
- key_basic: n_proto, ip_proto
- key_addrs.v4addrs: src and dst from the IPv4 header
- key_ports: src and dst u16 ports read at the L4 header

TCP and UDP both place the port pair at offset 0 of the L4
header, so one __be32 read covers both protocols.

On any miss the function returns false without touching
target_container. The caller falls back to the slow path.

Cold key slots that the slow path leaves untouched for this
packet shape (KEY_IP, KEY_TCP, KEY_VLAN, etc.) are not in the
standard dissector's key list. They stay at the caller's
pre-memset zero. Output is byte-identical to the slow path on
the standard dissectors.

Expected effect: about 30 ns/pkt saved on packets that match,
based on userspace measurements of the matching technique in the
XDP2 project. The saving comes from skipping the slow-path graph
walk. Cost on a miss is unchanged: one ethertype switch.

A follow-up selftest will compare fast-path and slow-path output
byte-by-byte to confirm the byte-identical claim.

Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 net/core/flow_dissector.c | 93 ++++++++++++++++++++++++++++++++++++---
 1 file changed, 88 insertions(+), 5 deletions(-)

diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index c5954916ad9f..bdba966d1d65 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -1040,10 +1040,16 @@ static bool is_pppoe_ses_hdr_valid(const struct pppoe_hdr *hdr)
  */
 static struct flow_dissector flow_keys_dissector_symmetric;
 
-/* Fast-path stub for eth+IPv4+{TCP,UDP} packets. Returns true when the
- * fast-path successfully filled @target_container; false to defer to
- * the slow path. This stub returns false unconditionally; the actual
- * extractor is added in a follow-up patch.
+/* Fast-path extractor for eth+IPv4+{TCP,UDP} packets.
+ *
+ * Handles the common-case packet shape: a 20-byte IPv4 header (no
+ * options, IHL == 5), no fragmentation, with TCP or UDP as the
+ * transport protocol. Other shapes (IP options, fragments, other
+ * protocols) defer to the slow path.
+ *
+ * Output is byte-identical to the slow path for this shape on the
+ * standard dissectors: key_control.addr_type / .thoff / .flags,
+ * key_basic.n_proto / .ip_proto, key_addrs.v4addrs, key_ports.
  */
 static bool flow_dissect_fast_ipv4(const struct sk_buff *skb,
 				   struct flow_dissector *flow_dissector,
@@ -1051,7 +1057,84 @@ static bool flow_dissect_fast_ipv4(const struct sk_buff *skb,
 				   const void *data,
 				   int nhoff, int hlen)
 {
-	return false;
+	struct flow_dissector_key_addrs *key_addrs;
+	struct flow_dissector_key_control *key_control;
+	struct flow_dissector_key_basic *key_basic;
+	struct flow_dissector_key_ports *key_ports;
+	const struct iphdr *iph;
+	int thoff;
+
+	/* Need IPv4 header + 4 bytes of L4 (src+dst ports). */
+	if (hlen - nhoff < (int)sizeof(*iph) + 4)
+		return false;
+
+	iph = (const struct iphdr *)((const u8 *)data + nhoff);
+
+	/* Require version == 4 and IHL == 5 (no IP options). The first
+	 * byte of an IPv4 header is (version << 4) | IHL, so the fast
+	 * shape matches exactly 0x45.
+	 */
+	if (*(const u8 *)iph != 0x45)
+		return false;
+
+	/* Defer fragmented packets to the slow path; it has explicit
+	 * fragment handling (FLOW_DIS_IS_FRAGMENT, first-frag flow).
+	 */
+	if (iph->frag_off & htons(IP_MF | IP_OFFSET))
+		return false;
+
+	/* Only TCP and UDP — these are the common L4 protocols and have
+	 * a fixed (src u16, dst u16) port layout at offset 0 of the L4
+	 * header. Other protocols (ICMP, GRE, ESP, AH, SCTP, ...) defer
+	 * to the slow path which has protocol-specific logic.
+	 */
+	if (iph->protocol != IPPROTO_TCP && iph->protocol != IPPROTO_UDP)
+		return false;
+
+	thoff = nhoff + (int)sizeof(*iph);
+
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_CONTROL)) {
+		key_control = skb_flow_dissector_target(flow_dissector,
+							FLOW_DISSECTOR_KEY_CONTROL,
+							target_container);
+		key_control->addr_type = FLOW_DISSECTOR_KEY_IPV4_ADDRS;
+		key_control->thoff = (u16)thoff;
+		key_control->flags = 0;
+	}
+
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_BASIC)) {
+		key_basic = skb_flow_dissector_target(flow_dissector,
+						      FLOW_DISSECTOR_KEY_BASIC,
+						      target_container);
+		key_basic->n_proto = htons(ETH_P_IP);
+		key_basic->ip_proto = iph->protocol;
+	}
+
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_IPV4_ADDRS)) {
+		key_addrs = skb_flow_dissector_target(flow_dissector,
+						      FLOW_DISSECTOR_KEY_IPV4_ADDRS,
+						      target_container);
+		memcpy(&key_addrs->v4addrs.src, &iph->saddr,
+		       sizeof(key_addrs->v4addrs.src));
+		memcpy(&key_addrs->v4addrs.dst, &iph->daddr,
+		       sizeof(key_addrs->v4addrs.dst));
+	}
+
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_PORTS)) {
+		const __be32 *ports = (const __be32 *)
+			((const u8 *)data + thoff);
+
+		key_ports = skb_flow_dissector_target(flow_dissector,
+						      FLOW_DISSECTOR_KEY_PORTS,
+						      target_container);
+		key_ports->ports = *ports;
+	}
+
+	return true;
 }
 
 /* Fast-path stub for eth+IPv6+{TCP,UDP} packets. As with the IPv4 stub
-- 
