From 28bc2795d2feac8f95a3b812fbeab1791b4bd29e Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Wed, 27 May 2026 15:01:10 -0700
Subject: [PATCH RFC 3/3] net: flow_dissector: add eth+IPv6+{TCP,UDP} fast-path
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Plug the IPv6 stub introduced in the framework patch with a
straight-line extractor for the common-case IPv6 shape:

  - Ethernet outer (ethertype == ETH_P_IPV6)
  - 40-byte fixed IPv6 header (version == 6)
  - No extension headers (nexthdr is TCP or UDP directly)
  - No non-zero flow label when the dissector asked for it

Extension headers (HBH, Routing, Fragment, ESP, AH, DSTOPTS,
Mobility, HIP, Shim6) are rare on internet RX traffic and the
slow path has explicit walkers for each — fast-path defers
those.

A non-zero IPv6 flow label is also deferred when the dissector
includes FLOW_DISSECTOR_KEY_FLOW_LABEL. The slow path writes
key_tags->flow_label in that case; the fast-path doesn't, so
to stay byte-exact we defer. Note that the flow label is zero
on the vast majority of internet traffic today (RFC 6437
allows but most stacks leave it at zero), so the fast-path
still hits on the common case.

Output is byte-identical to the slow path for this shape on the
standard dissectors: key_control.{addr_type,thoff,flags},
key_basic.{n_proto,ip_proto}, key_addrs.v6addrs, key_ports.

The same straight-line shape as the IPv4 fast-path with two
adjustments: 40-byte fixed header (no IHL field) and the
optional flow-label deferral. The check on the flow label
costs one ANDed-and-ORed test per IPv6 packet (~2 cycles); the
common case (label == 0) takes the early exit and proceeds to
the writes.

IPv6 is increasingly the bulk of internet RX traffic on modern
deployments (Google reports ~45 % of traffic is IPv6,
datacenter east-west often IPv6-only). This patch closes the
gap between the IPv4 and IPv6 fast-path coverage so dual-stack
and IPv6-first deployments see the same speedup.

Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 net/core/flow_dissector.c | 105 ++++++++++++++++++++++++++++++++++++--
 1 file changed, 101 insertions(+), 4 deletions(-)

diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index bdba966d1d65..c347afec290e 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -1137,9 +1137,27 @@ static bool flow_dissect_fast_ipv4(const struct sk_buff *skb,
 	return true;
 }
 
-/* Fast-path stub for eth+IPv6+{TCP,UDP} packets. As with the IPv4 stub
- * above, this returns false until the IPv6 fast-path is added in a
- * follow-up patch.
+/* Fast-path extractor for eth+IPv6+{TCP,UDP} packets.
+ *
+ * Handles the common-case shape: a 40-byte fixed IPv6 header with no
+ * extension headers, TCP or UDP as the transport. Extension headers
+ * (Hop-by-Hop, Routing, Fragment, ESP, AH, Destination Options,
+ * Mobility, HIP, Shim6, ...) defer to the slow path which has
+ * extension-header walking.
+ *
+ * Output is byte-identical to the slow path for this shape on the
+ * standard dissectors: key_control.addr_type / .thoff / .flags,
+ * key_basic.n_proto / .ip_proto, key_addrs.v6addrs, key_ports.
+ *
+ * The flow label is not extracted here — the standard dissector
+ * requests FLOW_DISSECTOR_KEY_FLOW_LABEL but only fills it when the
+ * label is non-zero; the caller's pre-memset leaves it as zero
+ * otherwise, which is the most common case on real traffic. Packets
+ * with a non-zero flow label defer to the slow path via the IPv6
+ * extension-header check below: the slow path handles them with its
+ * existing flow-label-extraction logic. (To stay byte-exact, this
+ * fast-path also defers when the standard dissector asks for the
+ * flow label and the packet carries a non-zero one.)
  */
 static bool flow_dissect_fast_ipv6(const struct sk_buff *skb,
 				   struct flow_dissector *flow_dissector,
@@ -1147,7 +1165,86 @@ static bool flow_dissect_fast_ipv6(const struct sk_buff *skb,
 				   const void *data,
 				   int nhoff, int hlen)
 {
-	return false;
+	struct flow_dissector_key_addrs *key_addrs;
+	struct flow_dissector_key_control *key_control;
+	struct flow_dissector_key_basic *key_basic;
+	struct flow_dissector_key_ports *key_ports;
+	const struct ipv6hdr *iph;
+	int thoff;
+
+	/* Need fixed IPv6 header + 4 bytes of L4 (src+dst ports). */
+	if (hlen - nhoff < (int)sizeof(*iph) + 4)
+		return false;
+
+	iph = (const struct ipv6hdr *)((const u8 *)data + nhoff);
+
+	/* Require version == 6 in the high nibble of the first byte.
+	 * The IPv6 header has no IHL — it's fixed 40 bytes.
+	 */
+	if ((*(const u8 *)iph >> 4) != 6)
+		return false;
+
+	/* Defer if nexthdr is anything but TCP or UDP. This covers all
+	 * extension headers (HBH, ROUTING, FRAGMENT, ESP, AH, DSTOPTS,
+	 * MH, HIP, SHIM6) along with rarer transports — the slow path
+	 * has explicit walkers for each.
+	 */
+	if (iph->nexthdr != IPPROTO_TCP && iph->nexthdr != IPPROTO_UDP)
+		return false;
+
+	/* Defer if the packet carries a non-zero flow label and the
+	 * caller asked for it: the slow path also writes
+	 * key_tags->flow_label in that case and we don't.
+	 */
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_FLOW_LABEL) &&
+	    (iph->flow_lbl[0] & 0x0f) | iph->flow_lbl[1] | iph->flow_lbl[2])
+		return false;
+
+	thoff = nhoff + (int)sizeof(*iph);
+
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_CONTROL)) {
+		key_control = skb_flow_dissector_target(flow_dissector,
+							FLOW_DISSECTOR_KEY_CONTROL,
+							target_container);
+		key_control->addr_type = FLOW_DISSECTOR_KEY_IPV6_ADDRS;
+		key_control->thoff = (u16)thoff;
+		key_control->flags = 0;
+	}
+
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_BASIC)) {
+		key_basic = skb_flow_dissector_target(flow_dissector,
+						      FLOW_DISSECTOR_KEY_BASIC,
+						      target_container);
+		key_basic->n_proto = htons(ETH_P_IPV6);
+		key_basic->ip_proto = iph->nexthdr;
+	}
+
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_IPV6_ADDRS)) {
+		key_addrs = skb_flow_dissector_target(flow_dissector,
+						      FLOW_DISSECTOR_KEY_IPV6_ADDRS,
+						      target_container);
+		memcpy(&key_addrs->v6addrs.src, &iph->saddr,
+		       sizeof(key_addrs->v6addrs.src));
+		memcpy(&key_addrs->v6addrs.dst, &iph->daddr,
+		       sizeof(key_addrs->v6addrs.dst));
+	}
+
+	if (dissector_uses_key(flow_dissector,
+			       FLOW_DISSECTOR_KEY_PORTS)) {
+		const __be32 *ports = (const __be32 *)
+			((const u8 *)data + thoff);
+
+		key_ports = skb_flow_dissector_target(flow_dissector,
+						      FLOW_DISSECTOR_KEY_PORTS,
+						      target_container);
+		key_ports->ports = *ports;
+	}
+
+	return true;
 }
 
 /* Try to dissect @data into @target_container using a straight-line
-- 
2.54.0

