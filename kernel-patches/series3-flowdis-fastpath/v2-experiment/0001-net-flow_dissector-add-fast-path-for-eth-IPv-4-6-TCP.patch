From 1cb8ab44280959bd19091a357ee564d3a0b7ca8b Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Mon, 1 Jun 2026 15:14:28 -0700
Subject: [PATCH RFC v2-experiment] net: flow_dissector: add fast-path for eth
 + IPv{4,6} + {TCP,UDP}

Inline a straight-line extractor into __skb_flow_dissect() for the
common L3+L4 packet shapes seen on the bulk of RX traffic:

  - eth + IPv4 + TCP or UDP (matched by 0x45 + frag_off check)
  - eth + IPv6 + TCP or UDP (matched by version + nexthdr check)

The fast-path runs after the BPF flow_dissector override check and
before the slow-path graph walk. It is attempted only for the two
standard dissectors (flow_keys_dissector and
flow_keys_dissector_symmetric) and only when the caller has not
requested any slow-path-only flag. On any miss it 'goto slow_path'
to the existing graph walk; no behaviour change for shapes the
fast-path does not handle.

The fast-path's output is byte-identical to the slow-path for the
shapes it handles: key_control.addr_type / .thoff / .flags,
key_basic.n_proto / .ip_proto, key_addrs.v{4,6}addrs, key_ports
(combined __be32 from L4 header offset 0; the same offset for
both TCP and UDP).

Two file-scope static_asserts codify the fixed header sizes the
fast-path depends on (sizeof(struct iphdr) == 20,
sizeof(struct ipv6hdr) == 40). The IHL == 5 / version checks
inside the fast-path hold the run-time invariant.

Result on Zen 2 (Threadripper PRO 3945WX) microbench, synthetic
eth+IPv4+TCP packet always hitting the fast-path:

  baseline: 12.44 ns/pkt
  patched:   6.56 ns/pkt
  delta:    -47.3 % (8x pooled stdev)

On Zen 1 the saving is below the clock_gettime resolution at p50
(visible only at p10); cycles are saved either way. No regression
on macro tests through sch_cake on either NIC family across
24h soaks (0 cake drops on i40e, 7 on mlx5 over 24h continuous
traffic, both pairs).

This series 3 follow-up to the small-region hash helper
(flow_hash_from_keys_small, recent) and the bpf_flow PPPoE patch
came out of the same XDP2-vs-kernel comparison work led by Tom
Herbert (https://github.com/randomizedcoder/xdp2). The technique
backports XDP2's R3.4 "fast-path chains" into hand-written kernel
C with no codegen / no new tooling / no ABI change.

Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 net/core/flow_dissector.c | 151 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 151 insertions(+)

diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index 2a98f5fa74eb..ffee6c71be1f 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -1035,6 +1035,18 @@ static bool is_pppoe_ses_hdr_valid(const struct pppoe_hdr *hdr)
 	return hdr->ver == 1 && hdr->type == 1 && hdr->code == 0;
 }
 
+/* Forward declaration: flow_keys_dissector_symmetric is defined later
+ * in this file (it is static); needed by the fast-path identity check
+ * inside __skb_flow_dissect() below.
+ */
+static struct flow_dissector flow_keys_dissector_symmetric;
+
+/* The fast-path in __skb_flow_dissect() below depends on these
+ * fixed header sizes. Codify the assumption at build time.
+ */
+static_assert(sizeof(struct iphdr) == 20);
+static_assert(sizeof(struct ipv6hdr) == 40);
+
 /**
  * __skb_flow_dissect - extract the flow_keys struct and return it
  * @net: associated network namespace, derived from @skb if NULL
@@ -1171,6 +1183,145 @@ bool __skb_flow_dissect(const struct net *net,
 
 	rcu_read_unlock();
 
+	/* Fast-path: straight-line extractor for the common L3+L4
+	 * shapes. Defers to the slow-path graph walk below on any
+	 * miss. Only attempted for the two standard dissectors and
+	 * only when no slow-path-only flag is requested. Output is
+	 * byte-identical to the slow path for the shapes handled.
+	 */
+	if ((flow_dissector == &flow_keys_dissector ||
+	     flow_dissector == &flow_keys_dissector_symmetric) &&
+	    !(flags & ~(unsigned int)FLOW_DISSECTOR_F_PARSE_1ST_FRAG)) {
+		struct flow_dissector_key_addrs *key_addrs;
+		struct flow_dissector_key_control *key_control;
+		struct flow_dissector_key_basic *key_basic;
+		struct flow_dissector_key_ports *key_ports;
+		int thoff;
+
+		if (proto == htons(ETH_P_IP)) {
+			const struct iphdr *iph;
+
+			/* sizeof(struct iphdr) == 20; codified by the
+			 * static_assert below the function. The IHL == 5
+			 * check (first byte == 0x45) holds the run-time
+			 * invariant.
+			 */
+			if (unlikely(hlen - nhoff < (int)sizeof(*iph) + 4))
+				goto slow_path;
+			iph = (const struct iphdr *)((const u8 *)data + nhoff);
+			if (unlikely(*(const u8 *)iph != 0x45))
+				goto slow_path;
+			if (unlikely(iph->frag_off & htons(IP_MF | IP_OFFSET)))
+				goto slow_path;
+			if (unlikely(iph->protocol != IPPROTO_TCP &&
+				     iph->protocol != IPPROTO_UDP))
+				goto slow_path;
+			thoff = nhoff + (int)sizeof(*iph);
+
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_CONTROL)) {
+				key_control = skb_flow_dissector_target(flow_dissector,
+									FLOW_DISSECTOR_KEY_CONTROL,
+									target_container);
+				key_control->addr_type = FLOW_DISSECTOR_KEY_IPV4_ADDRS;
+				key_control->thoff = (u16)thoff;
+				key_control->flags = 0;
+			}
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_BASIC)) {
+				key_basic = skb_flow_dissector_target(flow_dissector,
+								      FLOW_DISSECTOR_KEY_BASIC,
+								      target_container);
+				key_basic->n_proto = htons(ETH_P_IP);
+				key_basic->ip_proto = iph->protocol;
+			}
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_IPV4_ADDRS)) {
+				key_addrs = skb_flow_dissector_target(flow_dissector,
+								      FLOW_DISSECTOR_KEY_IPV4_ADDRS,
+								      target_container);
+				memcpy(&key_addrs->v4addrs.src, &iph->saddr,
+				       sizeof(key_addrs->v4addrs.src));
+				memcpy(&key_addrs->v4addrs.dst, &iph->daddr,
+				       sizeof(key_addrs->v4addrs.dst));
+			}
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_PORTS)) {
+				const __be32 *ports = (const __be32 *)
+					((const u8 *)data + thoff);
+
+				key_ports = skb_flow_dissector_target(flow_dissector,
+								      FLOW_DISSECTOR_KEY_PORTS,
+								      target_container);
+				key_ports->ports = *ports;
+			}
+			return true;
+		}
+
+		if (proto == htons(ETH_P_IPV6)) {
+			const struct ipv6hdr *iph;
+
+			if (unlikely(hlen - nhoff < (int)sizeof(*iph) + 4))
+				goto slow_path;
+			iph = (const struct ipv6hdr *)((const u8 *)data + nhoff);
+			if (unlikely((*(const u8 *)iph >> 4) != 6))
+				goto slow_path;
+			if (unlikely(iph->nexthdr != IPPROTO_TCP &&
+				     iph->nexthdr != IPPROTO_UDP))
+				goto slow_path;
+			/* Slow path writes key_tags->flow_label when the
+			 * dissector requests it and the label is non-zero;
+			 * defer to stay byte-identical.
+			 */
+			if (unlikely(dissector_uses_key(flow_dissector,
+							FLOW_DISSECTOR_KEY_FLOW_LABEL) &&
+				     ((iph->flow_lbl[0] & 0x0f) |
+				      iph->flow_lbl[1] | iph->flow_lbl[2])))
+				goto slow_path;
+			thoff = nhoff + (int)sizeof(*iph);
+
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_CONTROL)) {
+				key_control = skb_flow_dissector_target(flow_dissector,
+									FLOW_DISSECTOR_KEY_CONTROL,
+									target_container);
+				key_control->addr_type = FLOW_DISSECTOR_KEY_IPV6_ADDRS;
+				key_control->thoff = (u16)thoff;
+				key_control->flags = 0;
+			}
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_BASIC)) {
+				key_basic = skb_flow_dissector_target(flow_dissector,
+								      FLOW_DISSECTOR_KEY_BASIC,
+								      target_container);
+				key_basic->n_proto = htons(ETH_P_IPV6);
+				key_basic->ip_proto = iph->nexthdr;
+			}
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_IPV6_ADDRS)) {
+				key_addrs = skb_flow_dissector_target(flow_dissector,
+								      FLOW_DISSECTOR_KEY_IPV6_ADDRS,
+								      target_container);
+				memcpy(&key_addrs->v6addrs.src, &iph->saddr,
+				       sizeof(key_addrs->v6addrs.src));
+				memcpy(&key_addrs->v6addrs.dst, &iph->daddr,
+				       sizeof(key_addrs->v6addrs.dst));
+			}
+			if (dissector_uses_key(flow_dissector,
+					       FLOW_DISSECTOR_KEY_PORTS)) {
+				const __be32 *ports = (const __be32 *)
+					((const u8 *)data + thoff);
+
+				key_ports = skb_flow_dissector_target(flow_dissector,
+								      FLOW_DISSECTOR_KEY_PORTS,
+								      target_container);
+				key_ports->ports = *ports;
+			}
+			return true;
+		}
+	}
+slow_path:
+
 	if (dissector_uses_key(flow_dissector,
 			       FLOW_DISSECTOR_KEY_ETH_ADDRS)) {
 		struct ethhdr *eth = eth_hdr(skb);
-- 
2.54.0

