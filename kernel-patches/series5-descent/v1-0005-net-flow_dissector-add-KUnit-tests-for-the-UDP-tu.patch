From afaeb4112c1aa0a700c278727086dc666b3a342a Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Sat, 11 Jul 2026 09:20:50 -0700
Subject: [PATCH net-next v1 5/6] net: flow_dissector: add KUnit tests for the
 UDP-tunnel descents

Extend the fast/slow equivalence suite to the UDP-tunnel descents.
Because a descent changes the output relative to not descending, the
equivalence is checked the other way round: the descent gate is
pinned on and the entry gates are toggled, so one pass descends via
the fast path and the other descends via the slow path (the fast
dispatcher defers with the entry gates off). Both must produce the
same flow_keys and flow_hash_from_keys(), and every descent
equivalence check runs both with and without
FLOW_DISSECTOR_F_STOP_AT_FLOW_LABEL -- the flag skb_get_hash()
passes on every dissect -- and against both dissectors the
eligibility gate admits (flow_keys_dissector and the symmetric
one). An inner IPv6 flow with a non-zero flow label pins the
interaction of the two: the fast path defers on the label, so both
legs must take the identical slow descent. Tests keep the summary
descent key
(flow_dissector_udp_inner_any_key) in step with the individual gate
they pin, mirroring what the sysctl handler does.

The corpus exercises inner TCP/UDP for IPv4 and IPv6 underlays
(VXLAN, Geneve and GTP-U descend from both outer families; GTP-U
over IPv6 transport is the common mobile-core case),
IPv6-outer/IPv4-inner residue for fou/gue, inner ICMP and
Geneve/GTP-U out-of-subset packets (both keep the outer keys), and a
nested VXLAN chain past MAX_FLOW_DISSECT_HDRS (both bail at the same
depth). Dedicated cases pin down the control surfaces: STOP_AT_ENCAP
/ STOP_BEFORE_ENCAP callers keep the outer tuple even with a descent
gate on, and the descent header validation is exercised negatively
(VXLAN with the I flag clear or GBP bits set, Geneve OAM frames,
GTP-U with an option flag set -- all must keep the outer keys on both
paths).

A dummy netdev and a mock flow_dissector_fou_ops provider drive the
FOU/GUE lookup without real fou config. On kernels where the real
fou module is built in it owns the ops hook first; the FOU/GUE
cases then skip rather than fail (verified on x86_64 with
CONFIG_NET_FOU=y: the suite passes with those cases skipped, and
with CONFIG_NET_FOU=m or =n all cases run against the mock).

Assisted-by: Claude:claude-fable-5 sparse smatch
Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 net/core/flow_dissector_test.c | 733 ++++++++++++++++++++++++++++++++-
 1 file changed, 732 insertions(+), 1 deletion(-)

diff --git a/net/core/flow_dissector_test.c b/net/core/flow_dissector_test.c
index e0014affda7f..3a59af000daa 100644
--- a/net/core/flow_dissector_test.c
+++ b/net/core/flow_dissector_test.c
@@ -29,14 +29,22 @@
 #include <linux/skbuff.h>
 #include <linux/udp.h>
 #include <net/flow_dissector.h>
+#include <net/geneve.h>
 #include <net/gre.h>
+#include <net/gtp.h>
+#include <net/gue.h>
 #include <net/ip.h>
 #include <net/net_namespace.h>
+#include <net/vxlan.h>
+#include <uapi/linux/fou.h>
 
 #define FD_TEST_BUF_LEN 512
 #define FD_FUZZ_ITERS 4000
 
-/* The byte-identical fast-path gates. */
+/* The byte-identical fast-path gates (descent gates excluded: those
+ * change dissection output by design and are never part of the
+ * byte-identical contract).
+ */
 static struct static_key_false * const fd_fast_gates[] = {
 	&flow_dissector_eth_ip_key,
 	&flow_dissector_vlan_key,
@@ -47,6 +55,18 @@ static struct static_key_false * const fd_fast_gates[] = {
 	&flow_dissector_gre_key,
 };
 
+/* The behaviour-changing descent gates: individual tests pin these on
+ * and restore them; suite init/exit clears them too so a failing test
+ * can never leak an enabled gate into its successors.
+ */
+static struct static_key_false * const fd_descent_gates[] = {
+	&flow_dissector_vxlan_inner_key,
+	&flow_dissector_geneve_inner_key,
+	&flow_dissector_gtpu_inner_key,
+	&flow_dissector_gue_inner_key,
+	&flow_dissector_fou_inner_key,
+};
+
 static void fd_fast_gates_set(bool on)
 {
 	int i;
@@ -59,6 +79,21 @@ static void fd_fast_gates_set(bool on)
 	}
 }
 
+/* The slow path tests one summary key (flow_dissector_udp_inner_any_key)
+ * for "any descent gate enabled"; the sysctl handler maintains it. Tests
+ * toggling a descent gate directly must keep the summary in step.
+ */
+static void fd_descent_gate_set(struct static_key_false *gate, bool on)
+{
+	if (on) {
+		static_branch_enable(gate);
+		static_branch_enable(&flow_dissector_udp_inner_any_key);
+	} else {
+		static_branch_disable(gate);
+		static_branch_disable(&flow_dissector_udp_inner_any_key);
+	}
+}
+
 /* --- packet builders (network-layer payloads; __skb_flow_dissect is
  * called in raw-data mode with the L3 proto passed explicitly, so no
  * Ethernet header is included) ---
@@ -965,6 +1000,689 @@ static void fd_fast_fuzz_test(struct kunit *test)
 	}
 }
 
+/* --- FOU/GUE inner-descent tests ---
+ *
+ * FOU/GUE resolve the UDP port through the fou module's registered
+ * ops; a mock ops provider avoids real fou config, and skb mode with
+ * a dummy netdev supplies the netns. Descent changes the output, so
+ * these assert the inner 5-tuple directly.
+ */
+static __be16 fd_mock_port;
+static u16 fd_mock_type;
+static u8 fd_mock_proto;
+
+static u16 fd_mock_encap_lookup(const struct net *net, u8 family,
+				__be16 port, u8 *protocol)
+{
+	if (port != fd_mock_port)
+		return FOU_ENCAP_UNSPEC;
+	*protocol = fd_mock_proto;
+	return fd_mock_type;
+}
+
+static const struct flow_dissector_fou_ops fd_mock_fou_ops = {
+	.encap_lookup = fd_mock_encap_lookup,
+};
+
+static int put_udp(u8 *buf, __be16 dport)
+{
+	struct udphdr *uh = (struct udphdr *)buf;
+
+	uh->source = htons(0x9999);
+	uh->dest = dport;
+	uh->len = 0;
+	uh->check = 0;
+	return sizeof(*uh);
+}
+
+static int put_gue(u8 *buf, u8 proto_ctype)
+{
+	struct guehdr *gh = (struct guehdr *)buf;
+
+	gh->word = 0;
+	gh->proto_ctype = proto_ctype;	/* version 0, control 0, hlen 0 */
+	return sizeof(*gh);
+}
+
+/* Outer IPv4+UDP + optional GUE shim + inner IPv4+TCP. Outer addrs
+ * (10.0.0.x) are distinct from inner (192.168.x) so asserts can tell
+ * the descent happened.
+ */
+static int build_fou_gue_pkt(u8 *buf, __be16 dport, bool gue)
+{
+	struct iphdr *outer = (struct iphdr *)buf;
+	int n = put_ipv4(buf, IPPROTO_UDP, 5, 0);
+
+	outer->saddr = htonl(0x0a000001);	/* 10.0.0.1 */
+	outer->daddr = htonl(0x0a000002);	/* 10.0.0.2 */
+	n += put_udp(buf + n, dport);
+	if (gue)
+		n += put_gue(buf + n, IPPROTO_IPIP);
+	n += put_ipv4(buf + n, IPPROTO_TCP, 5, 0);
+	return n + put_ports(buf + n);
+}
+
+static void fd_fou_gue_descend(struct kunit *test, bool gue,
+			       struct static_key_false *gate)
+{
+	struct net_device *dev;
+	struct flow_keys keys;
+	struct sk_buff *skb;
+	__be16 dport = htons(0x17c0);
+	u8 *buf;
+	int len, ret;
+
+	buf = kunit_kzalloc(test, FD_TEST_BUF_LEN, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, buf);
+	len = build_fou_gue_pkt(buf, dport, gue);
+
+	dev = alloc_netdev(0, "fdtest%d", NET_NAME_UNKNOWN, ether_setup);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+
+	skb = alloc_skb(FD_TEST_BUF_LEN + NET_SKB_PAD, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, skb);
+	skb_reserve(skb, NET_SKB_PAD);
+	skb_put_data(skb, buf, len);
+	skb->protocol = htons(ETH_P_IP);
+	skb->dev = dev;
+	skb_reset_network_header(skb);
+
+	fd_mock_port = dport;
+	fd_mock_type = gue ? FOU_ENCAP_GUE : FOU_ENCAP_DIRECT;
+	fd_mock_proto = IPPROTO_IPIP;
+	ret = flow_dissector_fou_ops_register(&fd_mock_fou_ops);
+	if (ret == -EBUSY)
+		kunit_skip(test, "fou module owns the flow dissector ops");
+	KUNIT_ASSERT_EQ(test, 0, ret);
+
+	/* The descent hangs off the eth_ip fast path, so that gate must be
+	 * on for the dispatcher to reach it.
+	 */
+	static_branch_enable(&flow_dissector_eth_ip_key);
+	fd_descent_gate_set(gate, true);
+	memset(&keys, 0, sizeof(keys));
+	__skb_flow_dissect(&init_net, skb, &flow_keys_dissector, &keys,
+			   NULL, 0, 0, 0, 0);
+	fd_descent_gate_set(gate, false);
+	static_branch_disable(&flow_dissector_eth_ip_key);
+	flow_dissector_fou_ops_unregister(&fd_mock_fou_ops);
+
+	/* Descent must reach the inner 5-tuple: ENCAP set, inner addrs and
+	 * ports -- not the outer UDP tuple.
+	 */
+	KUNIT_EXPECT_TRUE(test, keys.control.flags & FLOW_DIS_ENCAPSULATION);
+	KUNIT_EXPECT_EQ(test, keys.basic.ip_proto, IPPROTO_TCP);
+	KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v4addrs.src), 0xc0a80101);
+	KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v4addrs.dst), 0xc0a80202);
+	KUNIT_EXPECT_EQ(test, ntohs(keys.ports.src), 0x1234);
+	KUNIT_EXPECT_EQ(test, ntohs(keys.ports.dst), 0x5678);
+
+	kfree_skb(skb);
+	free_netdev(dev);
+}
+
+static void fd_fast_gue_descend_test(struct kunit *test)
+{
+	fd_fou_gue_descend(test, true, &flow_dissector_gue_inner_key);
+}
+
+static void fd_fast_fou_descend_test(struct kunit *test)
+{
+	fd_fou_gue_descend(test, false, &flow_dissector_fou_inner_key);
+}
+
+/* ---- UDP-tunnel descent fast/slow equivalence ------------------------
+ *
+ * With a descent gate pinned on, one pass descends via the fast path
+ * (entry gates on) and the other via the slow path (entry gates off,
+ * dispatcher defers); both must produce identical flow_keys. skb mode
+ * with a dummy netdev (the FOU/GUE port lookup needs a netns).
+ */
+
+#define FD_FOU_DPORT	htons(0x17c0)
+
+static int put_vxlanhdr(u8 *buf, __be32 flags)
+{
+	struct vxlanhdr *vh = (struct vxlanhdr *)buf;
+
+	vh->vx_flags = flags;
+	vh->vx_vni = htonl(0x123400);
+	return sizeof(*vh);
+}
+
+static int put_genevehdr(u8 *buf, __be16 proto_type, u8 opt_len)
+{
+	struct genevehdr *gnv = (struct genevehdr *)buf;
+
+	memset(gnv, 0, sizeof(*gnv));		/* ver = 0 */
+	gnv->opt_len = opt_len;
+	gnv->proto_type = proto_type;
+	return sizeof(*gnv) + opt_len * 4;
+}
+
+static int put_gtp1(u8 *buf, u8 type)
+{
+	struct gtp1_header *gtp = (struct gtp1_header *)buf;
+
+	memset(gtp, 0, sizeof(*gtp));
+	gtp->flags = 0x30;			/* version 1, PT 1, no options */
+	gtp->type = type;			/* 0xff = G-PDU */
+	return sizeof(*gtp);
+}
+
+static int put_inner_eth(u8 *buf, __be16 proto)
+{
+	struct ethhdr *eth = (struct ethhdr *)buf;
+
+	memset(eth, 0, sizeof(*eth));
+	eth->h_proto = proto;
+	return ETH_HLEN;
+}
+
+static int put_outer_ipv4_udp(u8 *buf, __be16 dport)
+{
+	struct iphdr *o = (struct iphdr *)buf;
+	int n = put_ipv4(buf, IPPROTO_UDP, 5, 0);
+
+	o->saddr = htonl(0x0a000001);		/* 10.0.0.1 (distinct outer) */
+	o->daddr = htonl(0x0a000002);		/* 10.0.0.2 */
+	return n + put_udp(buf + n, dport);
+}
+
+static int put_outer_ipv6_udp(u8 *buf, __be16 dport)
+{
+	struct ipv6hdr *o = (struct ipv6hdr *)buf;
+	int n = put_ipv6(buf, IPPROTO_UDP, 0);
+
+	o->saddr.s6_addr32[1] = htonl(0x0a0a0a0a);	/* distinct outer */
+	o->daddr.s6_addr32[1] = htonl(0x0b0b0b0b);
+	return n + put_udp(buf + n, dport);
+}
+
+static int put_inner_ip(u8 *buf, bool inner_v6, u8 inner_l4)
+{
+	int n;
+
+	if (inner_v6)
+		n = put_ipv6(buf, inner_l4, 0);
+	else
+		n = put_ipv4(buf, inner_l4, 5, 0);
+	return n + put_ports(buf + n);
+}
+
+static int build_vxlan(u8 *buf, bool outer_v6, bool inner_v6, u8 inner_l4)
+{
+	int n = outer_v6 ? put_outer_ipv6_udp(buf, htons(IANA_VXLAN_UDP_PORT))
+			 : put_outer_ipv4_udp(buf, htons(IANA_VXLAN_UDP_PORT));
+
+	n += put_vxlanhdr(buf + n, VXLAN_HF_VNI);
+	n += put_inner_eth(buf + n, inner_v6 ? htons(ETH_P_IPV6)
+					     : htons(ETH_P_IP));
+	return n + put_inner_ip(buf + n, inner_v6, inner_l4);
+}
+
+/* VXLAN with non-conforming flags: I unset, or extension bits (GBP)
+ * set. RFC 7348 receivers must check I=1; the descent must not trust
+ * such a frame and keeps the outer keys.
+ */
+static int build_vxlan_flags(u8 *buf, __be32 flags)
+{
+	int n = put_outer_ipv4_udp(buf, htons(IANA_VXLAN_UDP_PORT));
+
+	n += put_vxlanhdr(buf + n, flags);
+	n += put_inner_eth(buf + n, htons(ETH_P_IP));
+	return n + put_inner_ip(buf + n, false, IPPROTO_TCP);
+}
+
+static int build_geneve(u8 *buf, bool outer_v6, bool inner_v6, u8 inner_l4,
+			u8 opt_len)
+{
+	int n = outer_v6 ? put_outer_ipv6_udp(buf, htons(GENEVE_UDP_PORT))
+			 : put_outer_ipv4_udp(buf, htons(GENEVE_UDP_PORT));
+
+	n += put_genevehdr(buf + n, htons(ETH_P_TEB), opt_len);
+	n += put_inner_eth(buf + n, inner_v6 ? htons(ETH_P_IPV6)
+					     : htons(ETH_P_IP));
+	return n + put_inner_ip(buf + n, inner_v6, inner_l4);
+}
+
+/* Geneve OAM control frame (RFC 8926 §3.1): must not descend. */
+static int build_geneve_oam(u8 *buf)
+{
+	int n = put_outer_ipv4_udp(buf, htons(GENEVE_UDP_PORT));
+	struct genevehdr *gnv = (struct genevehdr *)(buf + n);
+
+	n += put_genevehdr(buf + n, htons(ETH_P_TEB), 0);
+	gnv->oam = 1;
+	n += put_inner_eth(buf + n, htons(ETH_P_IP));
+	return n + put_inner_ip(buf + n, false, IPPROTO_TCP);
+}
+
+static int build_gtpu(u8 *buf, bool outer_v6, bool inner_v6, u8 inner_l4,
+		      u8 gtp_type)
+{
+	int n = outer_v6 ? put_outer_ipv6_udp(buf, htons(GTP1U_PORT))
+			 : put_outer_ipv4_udp(buf, htons(GTP1U_PORT));
+
+	n += put_gtp1(buf + n, gtp_type);
+	return n + put_inner_ip(buf + n, inner_v6, inner_l4);
+}
+
+/* GTP-U G-PDU with an option flag (S) set: the header grows a variable
+ * tail, so the descent must not trust the fixed-size layout.
+ */
+static int build_gtpu_espn(u8 *buf)
+{
+	int n = put_outer_ipv4_udp(buf, htons(GTP1U_PORT));
+	struct gtp1_header *gtp = (struct gtp1_header *)(buf + n);
+
+	n += put_gtp1(buf + n, 0xff);
+	gtp->flags = 0x32;		/* version 1, PT 1, S bit */
+	return n + put_inner_ip(buf + n, false, IPPROTO_TCP);
+}
+
+static int build_fou_gue(u8 *buf, bool gue, bool outer_v6, bool inner_v6,
+			 u8 inner_l4)
+{
+	int n = outer_v6 ? put_outer_ipv6_udp(buf, FD_FOU_DPORT)
+			 : put_outer_ipv4_udp(buf, FD_FOU_DPORT);
+
+	if (gue)
+		n += put_gue(buf + n, inner_v6 ? IPPROTO_IPV6 : IPPROTO_IPIP);
+	return n + put_inner_ip(buf + n, inner_v6, inner_l4);
+}
+
+/* Inner IPv6 with a non-zero flow label: the fast path defers (its
+ * inner IPv6 helper rejects any non-zero label), so both legs descend
+ * via the slow path; equivalence must hold under STOP_AT_FLOW_LABEL
+ * in particular.
+ */
+static int build_vxlan_v6label(u8 *buf)
+{
+	int n = put_outer_ipv4_udp(buf, htons(IANA_VXLAN_UDP_PORT));
+
+	n += put_vxlanhdr(buf + n, VXLAN_HF_VNI);
+	n += put_inner_eth(buf + n, htons(ETH_P_IPV6));
+	n += put_ipv6(buf + n, IPPROTO_TCP, 0x12345);
+	return n + put_ports(buf + n);
+}
+
+static int build_vxlan_nest(u8 *buf, int levels)
+{
+	int n = 0, i;
+
+	for (i = 0; i < levels; i++) {
+		n += put_outer_ipv4_udp(buf + n, htons(IANA_VXLAN_UDP_PORT));
+		n += put_vxlanhdr(buf + n, VXLAN_HF_VNI);
+		n += put_inner_eth(buf + n, htons(ETH_P_IP));
+	}
+	return n + put_inner_ip(buf + n, false, IPPROTO_TCP);
+}
+
+/* Descent gate pinned on; entry gates off (slow descends) vs on (fast
+ * descends). The two must be byte-identical.
+ */
+static void fd_descent_check_one(struct kunit *test, struct sk_buff *skb,
+				 struct flow_dissector *fd,
+				 unsigned int flags)
+{
+	struct flow_keys keys_slow, keys_fast;
+	bool ret_slow, ret_fast;
+
+	fd_fast_gates_set(false);
+	memset(&keys_slow, 0, sizeof(keys_slow));
+	ret_slow = __skb_flow_dissect(&init_net, skb, fd, &keys_slow,
+				      NULL, 0, 0, 0, flags);
+
+	fd_fast_gates_set(true);
+	memset(&keys_fast, 0, sizeof(keys_fast));
+	ret_fast = __skb_flow_dissect(&init_net, skb, fd, &keys_fast,
+				      NULL, 0, 0, 0, flags);
+	fd_fast_gates_set(false);
+
+	KUNIT_EXPECT_EQ(test, ret_slow, ret_fast);
+	KUNIT_EXPECT_MEMEQ(test, &keys_slow, &keys_fast, sizeof(keys_slow));
+	KUNIT_EXPECT_EQ(test, flow_hash_from_keys(&keys_slow),
+			flow_hash_from_keys(&keys_fast));
+}
+
+static void fd_descent_check(struct kunit *test, struct sk_buff *skb,
+			     struct static_key_false *descent_gate)
+{
+	/* skb_get_hash() passes STOP_AT_FLOW_LABEL on every dissect, so
+	 * descent equivalence must hold under it too -- and for both
+	 * dissectors the fast-path eligibility gate admits.
+	 */
+	static const unsigned int fd_flags[] = {
+		0,
+		FLOW_DISSECTOR_F_STOP_AT_FLOW_LABEL,
+	};
+	struct flow_dissector *fds[] = {
+		&flow_keys_dissector,
+		flow_keys_dissector_symmetric_kunit(),
+	};
+	int d, i;
+
+	fd_descent_gate_set(descent_gate, true);
+	for (d = 0; d < ARRAY_SIZE(fds); d++)
+		for (i = 0; i < ARRAY_SIZE(fd_flags); i++)
+			fd_descent_check_one(test, skb, fds[d], fd_flags[i]);
+	fd_descent_gate_set(descent_gate, false);
+}
+
+static struct sk_buff *fd_descent_skb(struct kunit *test, const u8 *buf,
+				      int len, __be16 outer_proto,
+				      struct net_device *dev)
+{
+	struct sk_buff *skb = alloc_skb(len + NET_SKB_PAD, GFP_KERNEL);
+
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, skb);
+	skb_reserve(skb, NET_SKB_PAD);
+	skb_put_data(skb, buf, len);
+	skb->protocol = outer_proto;
+	skb->dev = dev;
+	skb_reset_network_header(skb);
+	return skb;
+}
+
+static void fd_descent_run(struct kunit *test, const u8 *buf, int len,
+			   __be16 outer_proto, struct static_key_false *gate)
+{
+	struct net_device *dev;
+	struct sk_buff *skb;
+
+	dev = alloc_netdev(0, "fdtest%d", NET_NAME_UNKNOWN, ether_setup);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	skb = fd_descent_skb(test, buf, len, outer_proto, dev);
+	fd_descent_check(test, skb, gate);
+	kfree_skb(skb);
+	free_netdev(dev);
+}
+
+/* Assert the fast path actually reached the inner 5-tuple (guards against
+ * fast and slow being wrong in the same way, which equivalence can't see).
+ */
+static void fd_descent_assert_inner(struct kunit *test, const u8 *buf, int len,
+				    __be16 outer_proto,
+				    struct static_key_false *gate, bool inner_v6)
+{
+	struct net_device *dev;
+	struct flow_keys keys;
+	struct sk_buff *skb;
+
+	dev = alloc_netdev(0, "fdtest%d", NET_NAME_UNKNOWN, ether_setup);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	skb = fd_descent_skb(test, buf, len, outer_proto, dev);
+
+	static_branch_enable(&flow_dissector_eth_ip_key);
+	fd_descent_gate_set(gate, true);
+	memset(&keys, 0, sizeof(keys));
+	__skb_flow_dissect(&init_net, skb, &flow_keys_dissector, &keys,
+			   NULL, 0, 0, 0, 0);
+	fd_descent_gate_set(gate, false);
+	static_branch_disable(&flow_dissector_eth_ip_key);
+
+	KUNIT_EXPECT_TRUE(test, keys.control.flags & FLOW_DIS_ENCAPSULATION);
+	KUNIT_EXPECT_EQ(test, keys.basic.ip_proto, IPPROTO_TCP);
+	if (inner_v6) {
+		KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v6addrs.src.s6_addr32[3]), 1);
+		KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v6addrs.dst.s6_addr32[3]), 2);
+	} else {
+		KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v4addrs.src), 0xc0a80101);
+		KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v4addrs.dst), 0xc0a80202);
+	}
+	KUNIT_EXPECT_EQ(test, ntohs(keys.ports.src), 0x1234);
+	KUNIT_EXPECT_EQ(test, ntohs(keys.ports.dst), 0x5678);
+
+	kfree_skb(skb);
+	free_netdev(dev);
+}
+
+/* Assert the outer tuple was kept -- no descent happened (the frame
+ * failed tunnel-header validation with the gate on).
+ */
+static void fd_descent_assert_outer(struct kunit *test, const u8 *buf, int len,
+				    struct static_key_false *gate, __be16 dport)
+{
+	struct net_device *dev;
+	struct flow_keys keys;
+	struct sk_buff *skb;
+
+	dev = alloc_netdev(0, "fdtest%d", NET_NAME_UNKNOWN, ether_setup);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, dev);
+	skb = fd_descent_skb(test, buf, len, htons(ETH_P_IP), dev);
+
+	static_branch_enable(&flow_dissector_eth_ip_key);
+	fd_descent_gate_set(gate, true);
+	memset(&keys, 0, sizeof(keys));
+	__skb_flow_dissect(&init_net, skb, &flow_keys_dissector, &keys,
+			   NULL, 0, 0, 0, 0);
+	fd_descent_gate_set(gate, false);
+	static_branch_disable(&flow_dissector_eth_ip_key);
+
+	KUNIT_EXPECT_FALSE(test, keys.control.flags & FLOW_DIS_ENCAPSULATION);
+	KUNIT_EXPECT_EQ(test, keys.basic.ip_proto, IPPROTO_UDP);
+	KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v4addrs.src), 0x0a000001);
+	KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v4addrs.dst), 0x0a000002);
+	KUNIT_EXPECT_EQ(test, ntohs(keys.ports.src), 0x9999);
+	KUNIT_EXPECT_EQ(test, ntohs(keys.ports.dst), ntohs(dport));
+
+	kfree_skb(skb);
+	free_netdev(dev);
+}
+
+static void fd_descent_vxlan_test(struct kunit *test)
+{
+	struct static_key_false *g = &flow_dissector_vxlan_inner_key;
+	u8 *buf;
+	int len;
+
+	buf = kunit_kzalloc(test, FD_TEST_BUF_LEN, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, buf);
+
+	len = build_vxlan(buf, false, false, IPPROTO_TCP);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IP), g, false);
+
+	len = build_vxlan(buf, false, false, IPPROTO_UDP);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+
+	len = build_vxlan(buf, false, true, IPPROTO_TCP);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IP), g, true);
+
+	/* inner ICMP: fast defers (inner not TCP/UDP) -> both run slow. */
+	len = build_vxlan(buf, false, false, IPPROTO_ICMP);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+
+	/* Inner IPv6 with non-zero flow label: fast defers, both legs
+	 * take the slow descent -- must match under STOP_AT_FLOW_LABEL.
+	 */
+	len = build_vxlan_v6label(buf);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+
+	/* IPv6 underlay: same descent from an IPv6 outer. */
+	len = build_vxlan(buf, true, false, IPPROTO_TCP);
+	fd_descent_run(test, buf, len, htons(ETH_P_IPV6), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IPV6), g, false);
+
+	len = build_vxlan(buf, true, true, IPPROTO_TCP);
+	fd_descent_run(test, buf, len, htons(ETH_P_IPV6), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IPV6), g, true);
+
+	/* I flag unset: not valid RFC 7348 VXLAN — no descent, outer
+	 * tuple kept, fast == slow.
+	 */
+	len = build_vxlan_flags(buf, 0);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_outer(test, buf, len, g,
+				htons(IANA_VXLAN_UDP_PORT));
+
+	/* GBP extension bits set: outside plain VXLAN — same posture. */
+	len = build_vxlan_flags(buf, VXLAN_HF_GBP | VXLAN_HF_VNI);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_outer(test, buf, len, g,
+				htons(IANA_VXLAN_UDP_PORT));
+}
+
+static void fd_descent_geneve_test(struct kunit *test)
+{
+	struct static_key_false *g = &flow_dissector_geneve_inner_key;
+	u8 *buf;
+	int len;
+
+	buf = kunit_kzalloc(test, FD_TEST_BUF_LEN, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, buf);
+
+	len = build_geneve(buf, false, false, IPPROTO_TCP, 0);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IP), g, false);
+
+	len = build_geneve(buf, false, true, IPPROTO_UDP, 0);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+
+	/* IPv6 underlay: same descent from an IPv6 outer. */
+	len = build_geneve(buf, true, false, IPPROTO_TCP, 0);
+	fd_descent_run(test, buf, len, htons(ETH_P_IPV6), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IPV6), g, false);
+
+	/* opt_len != 0: outside the fast subset -> both keep outer keys. */
+	len = build_geneve(buf, false, false, IPPROTO_TCP, 1);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+
+	/* OAM control frame: never descend (RFC 8926 §3.1). */
+	len = build_geneve_oam(buf);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_outer(test, buf, len, g, htons(GENEVE_UDP_PORT));
+}
