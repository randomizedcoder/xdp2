+/* STOP_AT_ENCAP / STOP_BEFORE_ENCAP callers (RPS/RFS, tunnel
+ * drivers) keep the outer tuple even with a descent gate on: the
+ * slow-path descent is guarded on the flags and the dispatcher
+ * rejects them.
+ */
+static void fd_descent_stop_flags_test(struct kunit *test)
+{
+	static const unsigned int stop_flags[] = {
+		FLOW_DISSECTOR_F_STOP_AT_ENCAP,
+		FLOW_DISSECTOR_F_STOP_BEFORE_ENCAP,
+	};
+	struct flow_keys keys;
+	int i, len;
+	u8 *buf;
+
+	buf = kunit_kzalloc(test, FD_TEST_BUF_LEN, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, buf);
+	len = build_vxlan(buf, false, false, IPPROTO_TCP);
+
+	fd_descent_gate_set(&flow_dissector_vxlan_inner_key, true);
+	for (i = 0; i < ARRAY_SIZE(stop_flags); i++) {
+		fd_check_one(test, &flow_keys_dissector, buf,
+			     htons(ETH_P_IP), len, stop_flags[i]);
+
+		static_branch_enable(&flow_dissector_eth_ip_key);
+		memset(&keys, 0, sizeof(keys));
+		__skb_flow_dissect(&init_net, NULL, &flow_keys_dissector,
+				   &keys, buf, htons(ETH_P_IP), 0, len,
+				   stop_flags[i]);
+		static_branch_disable(&flow_dissector_eth_ip_key);
+
+		KUNIT_EXPECT_FALSE(test,
+				   keys.control.flags & FLOW_DIS_ENCAPSULATION);
+		KUNIT_EXPECT_EQ(test, keys.basic.ip_proto, IPPROTO_UDP);
+		KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v4addrs.src), 0x0a000001);
+		KUNIT_EXPECT_EQ(test, ntohl(keys.addrs.v4addrs.dst), 0x0a000002);
+		KUNIT_EXPECT_EQ(test, ntohs(keys.ports.dst), IANA_VXLAN_UDP_PORT);
+	}
+	fd_descent_gate_set(&flow_dissector_vxlan_inner_key, false);
+}
