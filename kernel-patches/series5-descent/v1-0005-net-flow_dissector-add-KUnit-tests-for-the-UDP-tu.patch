+static void fd_descent_gtpu_test(struct kunit *test)
+{
+	struct static_key_false *g = &flow_dissector_gtpu_inner_key;
+	u8 *buf;
+	int len;
+
+	buf = kunit_kzalloc(test, FD_TEST_BUF_LEN, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_ERR_OR_NULL(test, buf);
+
+	len = build_gtpu(buf, false, false, IPPROTO_TCP, 0xff);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IP), g, false);
+
+	len = build_gtpu(buf, false, true, IPPROTO_TCP, 0xff);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IP), g, true);
+
+	/* IPv6 underlay: GTP-U over an IPv6 transport (common in mobile
+	 * cores); same descent, naked inner IP.
+	 */
+	len = build_gtpu(buf, true, false, IPPROTO_TCP, 0xff);
+	fd_descent_run(test, buf, len, htons(ETH_P_IPV6), g);
+	fd_descent_assert_inner(test, buf, len, htons(ETH_P_IPV6), g, false);
+
+	/* not a G-PDU (type != 0xff): outside the fast subset. */
+	len = build_gtpu(buf, false, false, IPPROTO_TCP, 0xfe);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+
+	/* G-PDU with the S option flag: variable header length — outside
+	 * the subset, both paths keep the outer keys.
+	 */
+	len = build_gtpu_espn(buf);
+	fd_descent_run(test, buf, len, htons(ETH_P_IP), g);
+	fd_descent_assert_outer(test, buf, len, g, htons(GTP1U_PORT));
+}
