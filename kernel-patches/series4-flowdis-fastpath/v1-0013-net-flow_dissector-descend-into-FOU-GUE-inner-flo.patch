From ed8958133c81249b0b288fd4739dcb8eda4b7635 Mon Sep 17 00:00:00 2001
From: Dave Seddon <dave.seddon.ca@gmail.com>
Date: Thu, 9 Jul 2026 21:29:13 -0700
Subject: [PATCH net-next v1 13/15] net: flow_dissector: descend into FOU/GUE
 inner flow

Opt-in, off by default, byte-identical between the fast and slow paths.
FOU/GUE (Tom Herbert's UDP encapsulations) complete the UDP-tunnel
descent set alongside vxlan/geneve/gtpu.

Unlike VXLAN/Geneve/GTP-U, FOU and GUE have no well-known UDP port, so a
packet cannot be recognised from the wire alone. The dissector consults
the per-netns FOU table, which lives in the tristate fou module: the
built-in dissector reaches it through a registered
struct flow_dissector_fou_ops (registered/unregistered by fou_core.c,
which switches its fou_list to the _rcu list helpers for the lockless
walk). The netns is derived from the skb, so no signature threading; a
raw-buffer dissect (skb == NULL) does not descend.

The port lookup is an RCU list walk of the per-netns fou table --
O(configured fou/gue tunnels), typically a handful -- and runs per
outer-UDP packet only while a gate is on. Switching the table to a
hash is a noted follow-up if large tunnel counts appear.

  - GUE is self-describing: guehdr->proto_ctype gives the inner IP
    protocol. Only version-0 data messages with an IPIP/IPv6 inner are
    handled.
  - Direct FOU is bare -- the inner protocol is not on the wire, it is
    per-tunnel config -- so the port lookup also returns the configured
    inner protocol.

Both descend through the shared flow_dissect_fast_udp_inner() tail
(bounded, ENCAP stamped after the inner pass) on the fast side, and
through the matching branch of __skb_flow_dissect_udp_encap() on the
slow side, so fast == slow holds. Both outer IPv4 and IPv6 are handled.
Covered by the KUnit equivalence suite (with a mock ops provider, so no
real fou config is needed).

Gated by flow_dissector.{gue,fou}_inner, off by default; enabling
changes hashing and depends on the fou module being loaded.

Assisted-by: Claude:claude-fable-5 sparse smatch
Signed-off-by: Dave Seddon <dave.seddon.ca@gmail.com>
---
 Documentation/admin-guide/sysctl/net.rst |  59 ++++++++
 include/net/flow_dissector.h             |  24 ++++
 net/core/flow_dissector.c                | 173 ++++++++++++++++++++++-
 net/ipv4/fou_core.c                      |  48 ++++++-
 4 files changed, 299 insertions(+), 5 deletions(-)

diff --git a/Documentation/admin-guide/sysctl/net.rst b/Documentation/admin-guide/sysctl/net.rst
index 2ecad4abf914..7c7d30d9b599 100644
--- a/Documentation/admin-guide/sysctl/net.rst
+++ b/Documentation/admin-guide/sysctl/net.rst
@@ -667,6 +667,65 @@ over IPv6 outer.
 
 Default: 0
 
+gue_inner
+~~~~~~~~~
+
+Descends into the inner IPv4/IPv6 + TCP/UDP flow of a GUE (Generic UDP
+Encapsulation) packet for hashing. Unlike ``vxlan_inner`` /
+``geneve_inner`` / ``gtpu_inner``, GUE has no well-known UDP port, so the
+packet cannot be identified from the wire alone: the dissector consults
+the per-netns FOU table (in the ``fou`` module) to map the UDP
+destination port to a GUE tunnel. GUE is self-describing -- the
+``guehdr`` ``proto_ctype`` field gives the inner IP protocol -- so once
+the tunnel is matched the inner offset and protocol come from the packet.
+Only GUE version-0 data messages with an IPIP/IPv6 inner are handled;
+control messages, unknown versions/flags and non-IP inners keep the outer
+keys. When enabled the inner 5-tuple replaces the outer UDP one and
+key_control->flags gets FLOW_DIS_ENCAPSULATION.
+
+**Enabling this changes hashing**, and it depends on the ``fou`` module
+being loaded (it registers the port lookup). Off by default and gated
+independently; once on it is byte-identical between the fast and slow
+paths (the slow path grows the same descent).
+
+Default: 0
+
+fou_inner
+~~~~~~~~~
+
+Descends into the inner IP flow of a direct Foo-over-UDP (FOU) packet.
+Direct FOU is bare -- there is no encapsulation header and **the inner
+protocol is not on the wire**; it is per-tunnel configuration. The
+dissector consults the per-netns FOU table (``fou`` module) to map the
+UDP destination port to both "this is FOU" and the configured inner IP
+protocol, then descends into the inner IPv4/IPv6 flow. When enabled the
+inner 5-tuple replaces the outer UDP one and key_control->flags gets
+FLOW_DIS_ENCAPSULATION.
+
+**Enabling this changes hashing** and, because the inner protocol is not
+in the packet, it is fundamentally stateful: it needs the ``fou`` table,
+so it only works while the ``fou`` module is loaded and the tunnel is
+configured. It keeps the outer keys for any port that is not a configured
+direct-FOU tunnel, or whose inner protocol is not IP. Off by default;
+byte-identical between the fast and slow paths once on.
+
+Default: 0
+
+The ``/proc/net/flow_dissector_stats`` observability file
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+
+Read-only. Reports, per byte-identical shape, the number of packets the
+slow path handled (``occurrences``), the number the fast body handled
+(``fast_hits``), the resulting eligible fraction, and the current gate
+state, plus a total dissect count. Because the fast path returns before
+the slow-path classification, exactly one of the two counters is
+incremented per shaped packet depending on gate state, so
+``(occurrences + fast_hits) / dissects`` is a gate-invariant measure of
+how much traffic each shape's fast body would handle -- the signal an
+operator uses to decide whether a gate is worth enabling. The counters
+are per-cpu and summed on read; the per-packet cost is one increment on
+the already-hot classification path.
+
 3. /proc/sys/net/unix - Parameters for Unix domain sockets
 ----------------------------------------------------------
 
diff --git a/include/net/flow_dissector.h b/include/net/flow_dissector.h
index 81d970d8ca69..8a5e0bd925e7 100644
--- a/include/net/flow_dissector.h
+++ b/include/net/flow_dissector.h
@@ -438,6 +438,30 @@ extern struct static_key_false flow_dissector_gre_key;
 extern struct static_key_false flow_dissector_vxlan_inner_key;
 extern struct static_key_false flow_dissector_geneve_inner_key;
 extern struct static_key_false flow_dissector_gtpu_inner_key;
+extern struct static_key_false flow_dissector_gue_inner_key;
+extern struct static_key_false flow_dissector_fou_inner_key;
+
+/* FOU/GUE inner-flow descent.
+ *
+ * Unlike VXLAN/Geneve/GTP-U, FOU and GUE have no well-known UDP port, so
+ * the dissector cannot identify them from the packet alone — it must map
+ * the UDP destination port to its configured encapsulation. That config
+ * lives in the (tristate) fou module, which registers these ops so the
+ * built-in dissector can reach it without a direct module symbol
+ * reference. ->encap_lookup() is called under RCU from the packet path.
+ */
+struct flow_dissector_fou_ops {
+	/* Return the encapsulation (FOU_ENCAP_*, uapi/linux/fou.h) bound to
+	 * UDP @port in @net for @family (AF_INET/AF_INET6), or
+	 * FOU_ENCAP_UNSPEC if none. For FOU_ENCAP_DIRECT the inner IP
+	 * protocol is not on the wire; it is returned in *protocol.
+	 */
+	u16 (*encap_lookup)(const struct net *net, u8 family, __be16 port,
+			    u8 *protocol);
+};
+
+int flow_dissector_fou_ops_register(const struct flow_dissector_fou_ops *ops);
+void flow_dissector_fou_ops_unregister(const struct flow_dissector_fou_ops *ops);
 
 /* Per-shape counters for /proc/net/flow_dissector_stats.
  * occurrences[]: shape seen by the slow path (the eligible-fraction
diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index 9fc1817ebb53..c56715813e83 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -70,6 +70,66 @@ DEFINE_STATIC_KEY_FALSE(flow_dissector_geneve_inner_key);
 EXPORT_SYMBOL(flow_dissector_geneve_inner_key);
 DEFINE_STATIC_KEY_FALSE(flow_dissector_gtpu_inner_key);
 EXPORT_SYMBOL(flow_dissector_gtpu_inner_key);
+DEFINE_STATIC_KEY_FALSE(flow_dissector_gue_inner_key);
+EXPORT_SYMBOL(flow_dissector_gue_inner_key);
+DEFINE_STATIC_KEY_FALSE(flow_dissector_fou_inner_key);
+EXPORT_SYMBOL(flow_dissector_fou_inner_key);
+
+/* FOU/GUE inner descent needs the per-netns UDP-port -> encap config,
+ * which lives in the tristate fou module. It registers ops here; the
+ * descent calls ->encap_lookup() under RCU only when a gate is on.
+ */
+static const struct flow_dissector_fou_ops __rcu *flow_dissector_fou_ops;
+static DEFINE_MUTEX(flow_dissector_fou_ops_mutex);
+
+int flow_dissector_fou_ops_register(const struct flow_dissector_fou_ops *ops)
+{
+	int ret = 0;
+
+	mutex_lock(&flow_dissector_fou_ops_mutex);
+	if (rcu_access_pointer(flow_dissector_fou_ops))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(flow_dissector_fou_ops, ops);
+	mutex_unlock(&flow_dissector_fou_ops_mutex);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(flow_dissector_fou_ops_register);
+
+void flow_dissector_fou_ops_unregister(const struct flow_dissector_fou_ops *ops)
+{
+	mutex_lock(&flow_dissector_fou_ops_mutex);
+	if (rcu_access_pointer(flow_dissector_fou_ops) == ops)
+		rcu_assign_pointer(flow_dissector_fou_ops, NULL);
+	mutex_unlock(&flow_dissector_fou_ops_mutex);
+	synchronize_rcu();
+}
+EXPORT_SYMBOL_GPL(flow_dissector_fou_ops_unregister);
+
+/* Resolve the packet's netns (skb-mode only; the fou table is per-netns)
+ * and map a UDP dst port to its FOU/GUE encapsulation via the registered
+ * fou ops. Returns FOU_ENCAP_UNSPEC when there is no fou module, no
+ * netns (raw-buffer dissection), or no match. For FOU_ENCAP_DIRECT the
+ * inner IP protocol is not on the wire and is returned in *protocol.
+ */
+static u16 flow_dissect_fou_lookup(const struct sk_buff *skb, u8 family,
+				   __be16 port, u8 *protocol)
+{
+	const struct flow_dissector_fou_ops *ops;
+	const struct net *net = NULL;
+
+	guard(rcu)();
+	if (skb) {
+		if (skb->dev)
+			net = dev_net_rcu(skb->dev);
+		else if (skb->sk)
+			net = sock_net(skb->sk);
+	}
+	ops = rcu_dereference(flow_dissector_fou_ops);
+	if (!net || !ops)
+		return FOU_ENCAP_UNSPEC;
+	return ops->encap_lookup(net, family, port, protocol);
+}
 
 /* Per-cpu, summed on read via /proc/net/flow_dissector_stats.
  * occurrences[]: shape handled by the slow path (with the gate off,
@@ -310,6 +370,59 @@ flow_dissect_gtpu_inner_ok(const void *data, int thoff, int hlen, u8 family,
 	return true;
 }
 
+static __always_inline bool
+flow_dissect_gue_inner_ok(const void *data, int thoff, int hlen,
+			  __be16 *inner_proto, int *inner_nhoff)
+{
+	const struct guehdr *guehdr;
+	int gue_off, hdrlen;
+
+	gue_off = thoff + (int)sizeof(struct udphdr);
+	if (hlen - gue_off < (int)sizeof(*guehdr))
+		return false;
+	guehdr = (const struct guehdr *)((const u8 *)data + gue_off);
+	/* Version-0 data message only; no control, no unknown flags. */
+	if (guehdr->version != 0 || guehdr->control ||
+	    (guehdr->flags & ~GUE_FLAGS_ALL))
+		return false;
+	switch (guehdr->proto_ctype) {
+	case IPPROTO_IPIP:
+		*inner_proto = htons(ETH_P_IP);
+		break;
+	case IPPROTO_IPV6:
+		*inner_proto = htons(ETH_P_IPV6);
+		break;
+	default:
+		return false;
+	}
+	hdrlen = (int)sizeof(*guehdr) + guehdr->hlen * 4;
+	if (hlen - gue_off < hdrlen)
+		return false;
+	*inner_nhoff = gue_off + hdrlen;
+	return true;
+}
+
+/* Direct FOU is bare: the inner protocol comes from the fou table, not
+ * the wire, and the inner header follows the UDP header immediately.
+ */
+static __always_inline bool
+flow_dissect_fou_inner_ok(u8 ipproto, int thoff,
+			  __be16 *inner_proto, int *inner_nhoff)
+{
+	switch (ipproto) {
+	case IPPROTO_IPIP:
+		*inner_proto = htons(ETH_P_IP);
+		break;
+	case IPPROTO_IPV6:
+		*inner_proto = htons(ETH_P_IPV6);
+		break;
+	default:
+		return false;
+	}
+	*inner_nhoff = thoff + (int)sizeof(struct udphdr);
+	return true;
+}
+
 /* Try the UDP-tunnel descents on an outer UDP header at @thoff. A
  * packet the classifiers accept but the inner fast path cannot handle
  * defers, because the slow path will descend into it.
@@ -338,6 +451,27 @@ flow_dissect_fast_udp_tunnels(const struct sk_buff *skb,
 	    flow_dissect_gtpu_inner_ok(data, thoff, hlen, family,
 				       &inner_proto, &inner_nhoff))
 		goto descend;
+
+	if (static_branch_unlikely(&flow_dissector_gue_inner_key) ||
+	    static_branch_unlikely(&flow_dissector_fou_inner_key)) {
+		const __be16 *udp_ports =
+			(const __be16 *)((const u8 *)data + thoff);
+		u8 ipproto = 0;
+		u16 type;
+
+		type = flow_dissect_fou_lookup(skb, family, udp_ports[1],
+					       &ipproto);
+		if (type == FOU_ENCAP_GUE &&
+		    static_branch_unlikely(&flow_dissector_gue_inner_key) &&
+		    flow_dissect_gue_inner_ok(data, thoff, hlen,
+					      &inner_proto, &inner_nhoff))
+			goto descend;
+		if (type == FOU_ENCAP_DIRECT &&
+		    static_branch_unlikely(&flow_dissector_fou_inner_key) &&
+		    flow_dissect_fou_inner_ok(ipproto, thoff,
+					      &inner_proto, &inner_nhoff))
+			goto descend;
+	}
 	return FAST_TUNNEL_NONE;
 
 descend:
@@ -2094,6 +2228,27 @@ static bool __skb_flow_dissect_udp_encap(const struct sk_buff *skb,
 	    flow_dissect_gtpu_inner_ok(data, thoff, hlen, family,
 				       &inner_proto, &inner_nhoff))
 		goto descend;
+
+	if (static_branch_unlikely(&flow_dissector_gue_inner_key) ||
+	    static_branch_unlikely(&flow_dissector_fou_inner_key)) {
+		const __be16 *udp_ports =
+			(const __be16 *)((const u8 *)data + thoff);
+		u8 ipproto = 0;
+		u16 type;
+
+		type = flow_dissect_fou_lookup(skb, family, udp_ports[1],
+					       &ipproto);
+		if (type == FOU_ENCAP_GUE &&
+		    static_branch_unlikely(&flow_dissector_gue_inner_key) &&
+		    flow_dissect_gue_inner_ok(data, thoff, hlen,
+					      &inner_proto, &inner_nhoff))
+			goto descend;
+		if (type == FOU_ENCAP_DIRECT &&
+		    static_branch_unlikely(&flow_dissector_fou_inner_key) &&
+		    flow_dissect_fou_inner_ok(ipproto, thoff,
+					      &inner_proto, &inner_nhoff))
+			goto descend;
+	}
 	return false;
 
 descend:
@@ -2782,7 +2937,9 @@ bool __skb_flow_dissect(const struct net *net,
 		       FLOW_DISSECTOR_F_STOP_AT_ENCAP)) &&
 	    (static_branch_unlikely(&flow_dissector_vxlan_inner_key) ||
 	     static_branch_unlikely(&flow_dissector_geneve_inner_key) ||
-	     static_branch_unlikely(&flow_dissector_gtpu_inner_key)) &&
+	     static_branch_unlikely(&flow_dissector_gtpu_inner_key) ||
+	     static_branch_unlikely(&flow_dissector_gue_inner_key) ||
+	     static_branch_unlikely(&flow_dissector_fou_inner_key)) &&
 	    __skb_flow_dissect_udp_encap(skb, key_control, data, &proto, &nhoff,
 					 hlen,
 					 proto == htons(ETH_P_IP) ? AF_INET :
@@ -3370,6 +3527,20 @@ static struct ctl_table flow_dissector_sysctl_table[] = {
 		.mode		= 0644,
 		.proc_handler	= proc_do_static_key,
 	},
+	{
+		.procname	= "gue_inner",
+		.data		= &flow_dissector_gue_inner_key.key,
+		.maxlen		= sizeof(flow_dissector_gue_inner_key),
+		.mode		= 0644,
+		.proc_handler	= proc_do_static_key,
+	},
+	{
+		.procname	= "fou_inner",
+		.data		= &flow_dissector_fou_inner_key.key,
+		.maxlen		= sizeof(flow_dissector_fou_inner_key),
+		.mode		= 0644,
+		.proc_handler	= proc_do_static_key,
+	},
 };
 
 static const char * const flow_dissector_shape_names[FLOW_DISSECTOR_SHAPE__MAX] = {
diff --git a/net/ipv4/fou_core.c b/net/ipv4/fou_core.c
index 865bd7205122..faaf96990c1d 100644
--- a/net/ipv4/fou_core.c
+++ b/net/ipv4/fou_core.c
@@ -12,6 +12,7 @@
 #include <net/gro.h>
 #include <net/gue.h>
 #include <net/fou.h>
+#include <net/flow_dissector.h>
 #include <net/ip.h>
 #include <net/protocol.h>
 #include <net/udp.h>
@@ -550,7 +551,7 @@ static int fou_add_to_port_list(struct net *net, struct fou *fou,
 		}
 	}
 
-	list_add(&fou->list, &fn->fou_list);
+	list_add_tail_rcu(&fou->list, &fn->fou_list);
 	mutex_unlock(&fn->fou_lock);
 
 	return 0;
@@ -558,11 +559,42 @@ static int fou_add_to_port_list(struct net *net, struct fou *fou,
 
 static void fou_release(struct fou *fou)
 {
-	list_del(&fou->list);
+	list_del_rcu(&fou->list);
 	udp_tunnel_sock_release(fou->sk);
 	kfree_rcu(fou, rcu);
 }
 
+/* Flow-dissector FOU/GUE inner-descent hook.
+ *
+ * FOU/GUE have no well-known UDP port, so the flow dissector cannot
+ * identify them from the packet alone — it must map the UDP dst port to
+ * its configured encapsulation. That config lives here, in the
+ * (tristate) fou module, so the dissector reaches it through a
+ * registered ops table rather than a direct symbol reference. Called
+ * under RCU from the packet path; fou_list add/del use the _rcu variants
+ * above and freed entries are kfree_rcu()'d.
+ */
+static u16 fou_flow_encap_lookup(const struct net *net, u8 family,
+				 __be16 port, u8 *protocol)
+{
+	struct fou_net *fn = net_generic(net, fou_net_id);
+	u16 type = FOU_ENCAP_UNSPEC;
+	struct fou *fou;
+
+	list_for_each_entry_rcu(fou, &fn->fou_list, list) {
+		if (fou->port == port && fou->family == family) {
+			*protocol = fou->protocol;
+			type = fou->type;
+			break;
+		}
+	}
+	return type;
+}
+
+static const struct flow_dissector_fou_ops fou_flow_ops = {
+	.encap_lookup = fou_flow_encap_lookup,
+};
+
 static int fou_create(struct net *net, struct fou_cfg *cfg,
 		      struct socket **sockp)
 {
@@ -1255,8 +1287,15 @@ static int __init fou_init(void)
 		goto kfunc_failed;
 
 	ret = ip_tunnel_encap_add_fou_ops();
-	if (ret == 0)
-		return 0;
+	if (ret)
+		goto kfunc_failed;
+
+	/* Best-effort: the flow-dissector FOU/GUE descent is an
+	 * optional consumer; failure to register (another owner) must
+	 * not fail fou init.
+	 */
+	flow_dissector_fou_ops_register(&fou_flow_ops);
+	return 0;
 
 kfunc_failed:
 	genl_unregister_family(&fou_nl_family);
@@ -1268,6 +1307,7 @@ static int __init fou_init(void)
 
 static void __exit fou_fini(void)
 {
+	flow_dissector_fou_ops_unregister(&fou_flow_ops);
 	ip_tunnel_encap_del_fou_ops();
 	genl_unregister_family(&fou_nl_family);
 	unregister_pernet_device(&fou_net_ops);
