 static struct flow_dissector flow_keys_dissector_symmetric;
 
+/* Descend into the inner IP of a GUE-encapsulated packet (RFC). GUE is
+ * self-describing: guehdr->proto_ctype gives the inner IP protocol, so
+ * once the UDP port has been resolved to a GUE tunnel the inner offset
+ * and protocol come from the packet. Only version-0 data messages are
+ * handled (control messages and unknown versions defer). @thoff is the
+ * outer UDP header offset. Bounded by num_hdrs like the other tunnel
+ * descents; stamps FLOW_DIS_ENCAPSULATION after the inner pass.
+ */
+static bool flow_dissect_fast_gue_inner(const struct sk_buff *skb,
+					struct flow_dissector *flow_dissector,
+					void *target_container,
+					const void *data,
+					int thoff, int hlen, int num_hdrs)
+{
+	struct flow_dissector_key_control *key_control;
+	const struct guehdr *guehdr;
+	__be16 inner_proto;
+	int gue_off, inner_nhoff, hdrlen;
+	bool ok;
+
+	gue_off = thoff + (int)sizeof(struct udphdr);
+	if (unlikely(hlen - gue_off < (int)sizeof(*guehdr)))
+		return false;
+	guehdr = (const struct guehdr *)((const u8 *)data + gue_off);
+
+	/* Version 0 data message only; no control, no unknown flags. */
+	if (guehdr->version != 0 || guehdr->control ||
+	    (guehdr->flags & ~GUE_FLAGS_ALL))
+		return false;
+
+	switch (guehdr->proto_ctype) {
+	case IPPROTO_IPIP:
+		inner_proto = htons(ETH_P_IP);
+		break;
+	case IPPROTO_IPV6:
+		inner_proto = htons(ETH_P_IPV6);
+		break;
+	default:
+		return false;
+	}
+
+	hdrlen = (int)sizeof(*guehdr) + guehdr->hlen * 4;
+	if (unlikely(hlen - gue_off < hdrlen))
+		return false;
+	inner_nhoff = gue_off + hdrlen;
+
+	if (inner_proto == htons(ETH_P_IP))
+		ok = flow_dissect_fast_ipv4(skb, flow_dissector, target_container,
+					    data, inner_nhoff, hlen, num_hdrs);
+	else
+		ok = flow_dissect_fast_ipv6(skb, flow_dissector, target_container,
+					    data, inner_nhoff, hlen, num_hdrs);
+	if (!ok)
+		return false;
+
+	if (dissector_uses_key(flow_dissector, FLOW_DISSECTOR_KEY_CONTROL)) {
+		key_control = skb_flow_dissector_target(flow_dissector,
+							FLOW_DISSECTOR_KEY_CONTROL,
+							target_container);
+		key_control->flags |= FLOW_DIS_ENCAPSULATION;
+	}
+	return true;
+}
+
+/* Descend into the inner IP of a direct-FOU packet (RFC). Direct FOU is
+ * bare — the inner protocol is NOT on the wire; @inner_ipproto comes from
+ * the fou table (via flow_dissect_fou_lookup). @thoff is the outer UDP
+ * header offset; the inner header follows the UDP header immediately.
+ */
+static bool flow_dissect_fast_fou_inner(const struct sk_buff *skb,
+					struct flow_dissector *flow_dissector,
+					void *target_container,
+					const void *data,
+					int thoff, int hlen, int num_hdrs,
+					u8 inner_ipproto)
+{
+	struct flow_dissector_key_control *key_control;
+	__be16 inner_proto;
+	int inner_nhoff;
+	bool ok;
+
+	switch (inner_ipproto) {
+	case IPPROTO_IPIP:
+		inner_proto = htons(ETH_P_IP);
+		break;
+	case IPPROTO_IPV6:
+		inner_proto = htons(ETH_P_IPV6);
+		break;
+	default:
+		return false;
+	}
+
+	inner_nhoff = thoff + (int)sizeof(struct udphdr);
+	if (inner_proto == htons(ETH_P_IP))
+		ok = flow_dissect_fast_ipv4(skb, flow_dissector, target_container,
+					    data, inner_nhoff, hlen, num_hdrs);
+	else
+		ok = flow_dissect_fast_ipv6(skb, flow_dissector, target_container,
+					    data, inner_nhoff, hlen, num_hdrs);
+	if (!ok)
+		return false;
+
+	if (dissector_uses_key(flow_dissector, FLOW_DISSECTOR_KEY_CONTROL)) {
+		key_control = skb_flow_dissector_target(flow_dissector,
+							FLOW_DISSECTOR_KEY_CONTROL,
+							target_container);
+		key_control->flags |= FLOW_DIS_ENCAPSULATION;
+	}
+	return true;
+}
+
+/* Shared GUE/FOU descent hook, called from the IPv4/IPv6 fast helpers
+ * after the outer UDP ports. Resolves the UDP dst port to a FOU/GUE
+ * tunnel (per-netns fou table) and descends when the matching gate is
+ * on. @thoff is the UDP header offset, @family the outer IP family.
+ * Returns true if it consumed the packet (descended); *handled reports
+ * whether a descent was attempted so the caller can propagate the inner
+ * return value.
+ */
+static bool flow_dissect_fast_fou_gue(const struct sk_buff *skb,
+				      struct flow_dissector *flow_dissector,
+				      void *target_container, const void *data,
+				      int thoff, int hlen, int num_hdrs,
+				      u8 family, bool *descended)
+{
+	const __be16 *udp_ports;
+	__be16 dport;
+	u8 ipproto = 0;
+	u16 type;
+
+	*descended = false;
+	if (!static_branch_unlikely(&flow_dissector_gue_inner_key) &&
+	    !static_branch_unlikely(&flow_dissector_fou_inner_key))
+		return false;
+	if (hlen - thoff < (int)sizeof(struct udphdr))
+		return false;
+
+	udp_ports = (const __be16 *)((const u8 *)data + thoff);
+	dport = udp_ports[1];
+	type = flow_dissect_fou_lookup(skb, family, dport, &ipproto);
+
+	if (type == FOU_ENCAP_GUE &&
+	    static_branch_unlikely(&flow_dissector_gue_inner_key)) {
+		*descended = true;
+		return flow_dissect_fast_gue_inner(skb, flow_dissector,
+						   target_container, data,
+						   thoff, hlen, num_hdrs);
+	}
+	if (type == FOU_ENCAP_DIRECT &&
+	    static_branch_unlikely(&flow_dissector_fou_inner_key)) {
+		*descended = true;
+		return flow_dissect_fast_fou_inner(skb, flow_dissector,
+						   target_container, data,
+						   thoff, hlen, num_hdrs,
+						   ipproto);
+	}
+	return false;
+}
+
