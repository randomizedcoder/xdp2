index b5be949f0fac..ebddc0736ae5 100644
--- a/Documentation/admin-guide/sysctl/net.rst
+++ b/Documentation/admin-guide/sysctl/net.rst
@@ -672,6 +672,48 @@ GTP-U over IPv6 outer.
 
 Default: 0
 
+gue_inner
+~~~~~~~~~
+
+RFC EXPERIMENT. Descends into the inner IPv4/IPv6 + TCP/UDP flow of a
+GUE (Generic UDP Encapsulation) packet for hashing. Unlike
+``vxlan_inner``/``geneve_inner``/``gtpu_inner``, GUE has no well-known
+UDP port, so the packet cannot be identified from the wire alone: the
+dissector consults the per-netns FOU table (in the ``fou`` module) to
+map the UDP destination port to a GUE tunnel. GUE is self-describing —
+the ``guehdr`` ``proto_ctype`` field gives the inner IP protocol — so
+once the tunnel is matched the inner offset and protocol come from the
+packet. Only GUE version-0 data messages with an IPIP/IPv6 inner are
+handled; control messages, unknown versions/flags and non-IP inners
+defer to the slow path. When enabled the inner 5-tuple replaces the
+outer UDP one and key_control->flags gets FLOW_DIS_ENCAPSULATION.
+
+**This is a behaviour change**, not a byte-identical fast-path, and it
+depends on the ``fou`` module being loaded (it registers the port
+lookup). Same operator-facing posture as the other ``*_inner`` knobs.
+
+Default: 0
+
+fou_inner
+~~~~~~~~~
+
+RFC EXPERIMENT. Descends into the inner IP flow of a direct
+Foo-over-UDP (FOU) packet. Direct FOU is bare — there is no
+encapsulation header and **the inner protocol is not on the wire**; it
+is per-tunnel configuration. The dissector therefore consults the
+per-netns FOU table (``fou`` module) to map the UDP destination port to
+both "this is FOU" and the configured inner IP protocol, then descends
+into the inner IPv4/IPv6 flow. When enabled the inner 5-tuple replaces
+the outer UDP one and key_control->flags gets FLOW_DIS_ENCAPSULATION.
+
+**This is a behaviour change** and, because the inner protocol is not in
+the packet, it is fundamentally stateful: it needs the ``fou`` table, so
+it only works while the ``fou`` module is loaded and the tunnel is
+configured. It defers to the slow path for any port that is not a
+configured direct-FOU tunnel, or whose inner protocol is not IP.
+
+Default: 0
+
 auto
 ~~~~
 
diff --git a/include/net/flow_dissector.h b/include/net/flow_dissector.h
index 583c7bc45ebc..91d229053c21 100644
--- a/include/net/flow_dissector.h
+++ b/include/net/flow_dissector.h
@@ -441,6 +441,30 @@ extern struct static_key_false flow_dissector_gre_key;
 extern struct static_key_false flow_dissector_vxlan_inner_key;
 extern struct static_key_false flow_dissector_geneve_inner_key;
 extern struct static_key_false flow_dissector_gtpu_inner_key;
+extern struct static_key_false flow_dissector_gue_inner_key;
+extern struct static_key_false flow_dissector_fou_inner_key;
+
+/* RFC: FOU/GUE inner-flow descent.
+ *
+ * Unlike VXLAN/Geneve/GTP-U, FOU and GUE have no well-known UDP port, so
+ * the dissector cannot identify them from the packet alone — it must map
+ * the UDP destination port to its configured encapsulation. That config
+ * lives in the (tristate) fou module, which registers these ops so the
+ * built-in dissector can reach it without a direct module symbol
+ * reference. ->encap_lookup() is called under RCU from the packet path.
+ */
+struct flow_dissector_fou_ops {
+	/* Return the encapsulation (FOU_ENCAP_*, uapi/linux/fou.h) bound to
+	 * UDP @port in @net for @family (AF_INET/AF_INET6), or
+	 * FOU_ENCAP_UNSPEC if none. For FOU_ENCAP_DIRECT the inner IP
+	 * protocol is not on the wire; it is returned in *protocol.
+	 */
+	u16 (*encap_lookup)(const struct net *net, u8 family, __be16 port,
+			    u8 *protocol);
+};
+
+int flow_dissector_fou_ops_register(const struct flow_dissector_fou_ops *ops);
+void flow_dissector_fou_ops_unregister(const struct flow_dissector_fou_ops *ops);
 
 /* Per-shape traffic counters, exposed via /proc/net/flow_dissector_stats.
  * Byte-identical shapes only — the shapes the adaptive controller may
diff --git a/net/core/flow_dissector.c b/net/core/flow_dissector.c
index 4cc52970270d..7dd8a7d001c1 100644
--- a/net/core/flow_dissector.c
+++ b/net/core/flow_dissector.c
@@ -15,6 +15,8 @@
 #include <net/tipc.h>
 #include <net/vxlan.h>
 #include <net/geneve.h>
+#include <net/gue.h>
+#include <uapi/linux/fou.h>
 #include <net/gtp.h>
 #include <linux/igmp.h>
 #include <linux/icmp.h>
@@ -70,6 +72,68 @@ DEFINE_STATIC_KEY_FALSE(flow_dissector_geneve_inner_key);
 EXPORT_SYMBOL(flow_dissector_geneve_inner_key);
 DEFINE_STATIC_KEY_FALSE(flow_dissector_gtpu_inner_key);
 EXPORT_SYMBOL(flow_dissector_gtpu_inner_key);
+DEFINE_STATIC_KEY_FALSE(flow_dissector_gue_inner_key);
+EXPORT_SYMBOL(flow_dissector_gue_inner_key);
+DEFINE_STATIC_KEY_FALSE(flow_dissector_fou_inner_key);
+EXPORT_SYMBOL(flow_dissector_fou_inner_key);
+
+/* RFC: FOU/GUE inner descent needs the per-netns UDP-port -> encap
+ * config, which lives in the tristate fou module. It registers ops here;
+ * the descent calls ->encap_lookup() under RCU only when a gate is on.
+ */
+static const struct flow_dissector_fou_ops __rcu *flow_dissector_fou_ops;
+static DEFINE_MUTEX(flow_dissector_fou_ops_mutex);
+
+int flow_dissector_fou_ops_register(const struct flow_dissector_fou_ops *ops)
+{
+	int ret = 0;
+
+	mutex_lock(&flow_dissector_fou_ops_mutex);
+	if (rcu_access_pointer(flow_dissector_fou_ops))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(flow_dissector_fou_ops, ops);
+	mutex_unlock(&flow_dissector_fou_ops_mutex);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(flow_dissector_fou_ops_register);
+
+void flow_dissector_fou_ops_unregister(const struct flow_dissector_fou_ops *ops)
+{
+	mutex_lock(&flow_dissector_fou_ops_mutex);
+	if (rcu_access_pointer(flow_dissector_fou_ops) == ops)
+		rcu_assign_pointer(flow_dissector_fou_ops, NULL);
+	mutex_unlock(&flow_dissector_fou_ops_mutex);
+	synchronize_rcu();
+}
+EXPORT_SYMBOL_GPL(flow_dissector_fou_ops_unregister);
+
+/* Resolve the packet's netns (skb-mode only; the fou table is per-netns)
+ * and map a UDP dst port to its FOU/GUE encapsulation via the registered
+ * fou ops (RFC). Returns FOU_ENCAP_UNSPEC when there is no fou module, no
+ * netns (raw-buffer dissection), or no match. For FOU_ENCAP_DIRECT the
+ * inner IP protocol is not on the wire and is returned in *protocol.
+ */
+static u16 flow_dissect_fou_lookup(const struct sk_buff *skb, u8 family,
+				   __be16 port, u8 *protocol)
+{
+	const struct flow_dissector_fou_ops *ops;
+	u16 type = FOU_ENCAP_UNSPEC;
+	const struct net *net = NULL;
+
+	rcu_read_lock();
+	if (skb) {
+		if (skb->dev)
+			net = dev_net_rcu(skb->dev);
+		else if (skb->sk)
+			net = sock_net(skb->sk);
+	}
+	ops = rcu_dereference(flow_dissector_fou_ops);
+	if (net && ops)
+		type = ops->encap_lookup(net, family, port, protocol);
+	rcu_read_unlock();
+	return type;
+}
 
 /* Per-shape traffic counters (mechanism only; do not affect dissection).
  * Per-cpu, summed on read via /proc/net/flow_dissector_stats. occurrences[]
@@ -161,6 +225,165 @@ static bool flow_dissect_fast_gre_inner(const struct sk_buff *skb,
