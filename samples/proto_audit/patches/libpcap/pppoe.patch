--- /dev/null
+++ b/pcap/proto_audit/pppoe.h
@@ -0,0 +1,19 @@
+/*
+ * pppoe.h — pppoe_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_PPPOE_H
+#define PROTO_AUDIT_PPPOE_H
+
+#include <stdint.h>
+
+/* PPPoE header (RFC 2516) — 6 bytes */
+struct pppoe_header {
+    uint8_t  pppoe_version:4;
+    uint8_t  pppoe_type:4;
+    uint8_t  pppoe_code;
+    uint16_t pppoe_session_id;
+    uint16_t pppoe_length;
+};
+
+#endif /* PROTO_AUDIT_PPPOE_H */
