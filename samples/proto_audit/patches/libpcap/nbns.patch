+/*
+ * nbns.h — nbns_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_NBNS_H
+#define PROTO_AUDIT_NBNS_H
+
+#include <stdint.h>
+
+/* NBNS header — 50 bytes minimum */
+struct nbns_header {
+    uint16_t nbns_id;
+    uint16_t nbns_flags;
+    uint16_t nbns_queries;
+    uint16_t nbns_answers;
+    uint16_t nbns_auth_rr;
+    uint16_t nbns_add_rr;
+};
+
+#endif /* PROTO_AUDIT_NBNS_H */
