--- /dev/null
+++ b/pcap/proto_audit/dns.h
@@ -0,0 +1,20 @@
+/*
+ * dns.h — dns_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_DNS_H
+#define PROTO_AUDIT_DNS_H
+
+#include <stdint.h>
+
+/* DNS header (RFC 1035) — 12 bytes */
+struct dns_header {
+    uint16_t dns_id;
+    uint16_t dns_flags;
+    uint16_t dns_qd_count;
+    uint16_t dns_an_count;
+    uint16_t dns_ns_count;
+    uint16_t dns_ar_count;
+};
+
+#endif /* PROTO_AUDIT_DNS_H */
