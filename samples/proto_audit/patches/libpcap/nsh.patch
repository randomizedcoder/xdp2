+ * nsh.h — nsh_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_NSH_H
+#define PROTO_AUDIT_NSH_H
+
+#include <stdint.h>
+
+/* NSH header (RFC 8300) — 8 bytes */
+struct nsh_header {
+    uint16_t nsh_flags_length;
+    uint16_t nsh_md_type_next_proto;
+    uint32_t nsh_spi_si;
+};
