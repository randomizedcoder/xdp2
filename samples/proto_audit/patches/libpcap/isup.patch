+/*
+ * isup.h — isup_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_ISUP_H
+#define PROTO_AUDIT_ISUP_H
+
+#include <stdint.h>
+
+/* Isup header — 29 bytes minimum */
+struct isup_header {
+    uint16_t isup_cic;
+    uint8_t  isup_message_type;
+    uint8_t  _pad3[6];
