+/*
+ * fcoe.h — fcoe_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_FCOE_H
+#define PROTO_AUDIT_FCOE_H
+
+#include <stdint.h>
+
+/* FCoE header — 14 bytes minimum */
+struct fcoe_header {
+    uint8_t  fcoe_ver;
+    uint8_t  _pad1[12];
+    uint8_t  fcoe_sof;
+    uint8_t  _pad14[56];
+    uint32_t fcoe_crc;
+    uint8_t  fcoe_eof;
+};
+
+#endif /* PROTO_AUDIT_FCOE_H */
