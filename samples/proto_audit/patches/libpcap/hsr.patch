+/*
+ * hsr.h — hsr_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_HSR_H
+#define PROTO_AUDIT_HSR_H
+
+#include <stdint.h>
+
+/* HSR tag (IEC 62439-3) — 6 bytes */
+struct hsr_header {
+    uint16_t hsr_path_lsdu_size;
+    uint16_t hsr_seq_nr;
+    uint16_t hsr_ether_type;
+};
