+/*
+ * btle.h — btle_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_BTLE_H
+#define PROTO_AUDIT_BTLE_H
+
+#include <stdint.h>
+
+/* Btle header — 44 bytes minimum */
+struct btle_header {
+    uint32_t btle_access_address;
+    uint16_t btle_advertising_header;
