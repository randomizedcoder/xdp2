--- /dev/null
+++ b/pcap/proto_audit/uftp.h
@@ -0,0 +1,21 @@
+/*
+ * uftp.h — uftp_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_UFTP_H
+#define PROTO_AUDIT_UFTP_H
+
+#include <stdint.h>
+
+/* Uftp header — 80 bytes minimum */
+struct uftp_header {
+    uint8_t  uftp_version;
+    uint8_t  uftp_func;
+    uint16_t uftp_blsize;
+    uint32_t uftp_group_id;
+    uint32_t uftp_srcaddr;
+    uint32_t uftp_destaddr;
+    uint8_t  uftp_announce[64];
+};
+
+#endif /* PROTO_AUDIT_UFTP_H */
