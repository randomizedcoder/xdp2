--- /dev/null
+++ b/pcap/proto_audit/m3ua.h
@@ -0,0 +1,19 @@
+/*
+ * m3ua.h — m3ua_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_M3UA_H
+#define PROTO_AUDIT_M3UA_H
+
+#include <stdint.h>
+
+/* M3ua header — 132 bytes minimum */
+struct m3ua_header {
+    uint8_t  m3ua_version;
+    uint8_t  m3ua_reserved;
+    uint8_t  m3ua_message_class;
+    uint8_t  m3ua_message_type;
+    uint32_t m3ua_message_length;
+};
+
+#endif /* PROTO_AUDIT_M3UA_H */
