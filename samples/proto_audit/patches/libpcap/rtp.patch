--- /dev/null
+++ b/pcap/proto_audit/rtp.h
@@ -0,0 +1,19 @@
+/*
+ * rtp.h — rtp_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_RTP_H
+#define PROTO_AUDIT_RTP_H
+
+#include <stdint.h>
+
+/* RTP header (RFC 3550) — 12 bytes minimum */
+struct rtp_header {
+    uint8_t  rtp_ver_p_x_cc;   /* V(2)+P(1)+X(1)+CC(4) */
+    uint8_t  rtp_m_pt;         /* M(1)+PT(7) */
+    uint16_t rtp_seq;          /* sequence number */
+    uint32_t rtp_timestamp;
+    uint32_t rtp_ssrc;         /* synchronization source */
+};
+
+#endif /* PROTO_AUDIT_RTP_H */
