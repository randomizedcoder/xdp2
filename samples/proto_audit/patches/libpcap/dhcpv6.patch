--- /dev/null
+++ b/pcap/proto_audit/dhcpv6.h
@@ -0,0 +1,20 @@
+/*
+ * dhcpv6.h — dhcpv6_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_DHCPV6_H
+#define PROTO_AUDIT_DHCPV6_H
+
+#include <stdint.h>
+
+/* DHCPv6 header — 52 bytes minimum */
+struct dhcpv6_header {
+    uint8_t  dhcpv6_msgtype;
+    uint8_t  dhcpv6_xid;
+    uint8_t  dhcpv6_type_str[18];
+    uint64_t dhcpv6_type_str;
+    uint8_t  dhcpv6_type_str;
+    uint8_t  dhcpv6_type_str[16];
+};
+
+#endif /* PROTO_AUDIT_DHCPV6_H */
