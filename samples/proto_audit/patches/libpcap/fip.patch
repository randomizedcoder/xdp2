--- /dev/null
+++ b/pcap/proto_audit/fip.h
@@ -0,0 +1,22 @@
+/*
+ * fip.h — fip_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_FIP_H
+#define PROTO_AUDIT_FIP_H
+
+#include <stdint.h>
+
+/* FIP header — 58 bytes minimum */
+struct fip_header {
+    uint8_t  fip_ver;
+    uint8_t  _pad1[1];
+    uint16_t fip_opcode;
+    uint8_t  fip_reserved;
+    uint8_t  fip_disc_subcode;
+    uint16_t fip_dl_len;
+    uint16_t fip_flags;
+    uint8_t  fip_descriptors[48];
+};
+
+#endif /* PROTO_AUDIT_FIP_H */
