--- /dev/null
+++ b/pcap/proto_audit/ospf.h
@@ -0,0 +1,20 @@
+/*
+ * ospf.h — ospf_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_OSPF_H
+#define PROTO_AUDIT_OSPF_H
+
+#include <stdint.h>
+
+/* OSPFv2 header (RFC 2328) — 24 bytes */
+struct ospf_header {
+    uint8_t  ospf_version;
+    uint8_t  ospf_type;
+    uint16_t ospf_length;
+    uint32_t ospf_router_id;
+    uint32_t ospf_area_id;
+    uint16_t ospf_checksum;
+    uint16_t ospf_auth_type;
+    uint64_t ospf_auth_data;
+};
+
+#endif /* PROTO_AUDIT_OSPF_H */
