--- /dev/null
+++ b/pcap/proto_audit/dcerpc.h
@@ -0,0 +1,33 @@
+/*
+ * dcerpc.h — dcerpc_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_DCERPC_H
+#define PROTO_AUDIT_DCERPC_H
+
+#include <stdint.h>
+
+/* Dcerpc header — 376 bytes minimum */
+struct dcerpc_header {
+    uint8_t  dcerpc_ver;
+    uint8_t  dcerpc_pkt_type;
+    uint8_t  dcerpc_dg_flags1;
+    uint8_t  dcerpc_dg_flags2;
+    uint8_t  dcerpc_drep;
+    uint8_t  dcerpc_dg_serial_hi;
+    uint8_t  dcerpc_obj_id[16];
+    uint8_t  dcerpc_dg_if_id[16];
+    uint8_t  dcerpc_dg_act_id[16];
+    uint32_t dcerpc_dg_server_boot;
+    uint32_t dcerpc_dg_if_ver;
+    uint32_t dcerpc_dg_seqnum;
+    uint16_t dcerpc_opnum;
+    uint16_t dcerpc_dg_ihint;
+    uint16_t dcerpc_dg_ahint;
+    uint16_t dcerpc_dg_frag_len;
+    uint16_t dcerpc_dg_frag_num;
+    uint8_t  dcerpc_dg_auth_proto;
+    uint8_t  dcerpc_dg_serial_lo;
+};
+
+#endif /* PROTO_AUDIT_DCERPC_H */
