--- /dev/null
+++ b/pcap/proto_audit/mpls.h
@@ -0,0 +1,18 @@
+/*
+ * mpls.h — mpls_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_MPLS_H
+#define PROTO_AUDIT_MPLS_H
+
+#include <stdint.h>
+
+/* MPLS label stack entry (RFC 3032) — 4 bytes */
+struct mpls_header {
+    uint32_t mpls_label:20;
+    uint32_t mpls_traffic_class:3;
+    uint32_t mpls_bottom_of_stack:1;
+    uint32_t mpls_ttl:8;
+};
+
+#endif /* PROTO_AUDIT_MPLS_H */
