--- /dev/null
+++ b/pcap/proto_audit/erspan.h
@@ -0,0 +1,22 @@
+/*
+ * erspan.h — erspan_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_ERSPAN_H
+#define PROTO_AUDIT_ERSPAN_H
+
+#include <stdint.h>
+
+/* ERSPAN Type II header (Cisco) — 8 bytes */
+struct erspan_header {
+    uint16_t erspan_version:4;
+    uint16_t erspan_vlan:12;
+    uint16_t erspan_cos:3;
+    uint16_t erspan_bso:2;
+    uint16_t erspan_truncated:1;
+    uint16_t erspan_session_id:10;
+    uint32_t erspan_reserved:12;
+    uint32_t erspan_index:20;
+};
+
+#endif /* PROTO_AUDIT_ERSPAN_H */
