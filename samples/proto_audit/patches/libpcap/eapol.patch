@@ -0,0 +1,17 @@
+/*
+ * eapol.h — eapol_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_EAPOL_H
+#define PROTO_AUDIT_EAPOL_H
+
+#include <stdint.h>
+
+/* EAPOL header (IEEE 802.1X) — 4 bytes */
+struct eapol_header {
+    uint8_t  eapol_version;
+    uint8_t  eapol_type;
+    uint16_t eapol_length;
+};
+
+#endif /* PROTO_AUDIT_EAPOL_H */
