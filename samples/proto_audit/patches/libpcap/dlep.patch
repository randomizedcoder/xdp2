+/*
+ * dlep.h — dlep_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_DLEP_H
+#define PROTO_AUDIT_DLEP_H
+
+#include <stdint.h>
+
+/* Dlep header — 28 bytes minimum */
+struct dlep_header {
+    uint32_t dlep_signature;
+    uint16_t dlep_type;
+    uint16_t dlep_length;
+    uint8_t  dlep_dataitem[20];
+};
