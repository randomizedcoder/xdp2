--- /dev/null
+++ b/pcap/proto_audit/uftp4.h
@@ -0,0 +1,24 @@
+/*
+ * uftp4.h — uftp4_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_UFTP4_H
+#define PROTO_AUDIT_UFTP4_H
+
+#include <stdint.h>
+
+/* Uftp4 header — 40 bytes minimum */
+struct uftp4_header {
+    uint8_t  uftp4_version;
+    uint8_t  uftp4_func;
+    uint16_t uftp4_seq;
+    uint32_t uftp4_src_id;
+    uint32_t uftp4_group_id;
+    uint8_t  uftp4_group_inst;
+    uint8_t  uftp4_grtt;
+    uint8_t  uftp4_gsize;
+    uint8_t  uftp4_reserved;
+    uint8_t  uftp4_announce[24];
+};
+
+#endif /* PROTO_AUDIT_UFTP4_H */
