+/*
+ * swils.h — swils_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_SWILS_H
+#define PROTO_AUDIT_SWILS_H
+
+#include <stdint.h>
+
+/* Swils header — 48 bytes minimum */
+struct swils_header {
+    uint8_t  swils_opcode;
+    uint8_t  _pad1[19];
+    uint32_t swils_options;
+    uint32_t swils_hloint;
+    uint32_t swils_deadint;
+    uint8_t  _pad32[3];
+    uint8_t  swils_rcvdomid;
+    uint8_t  _pad36[1];
+    uint8_t  swils_origpidx;
+};
+
+#endif /* PROTO_AUDIT_SWILS_H */
