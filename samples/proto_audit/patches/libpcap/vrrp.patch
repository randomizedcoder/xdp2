--- /dev/null
+++ b/pcap/proto_audit/vrrp.h
@@ -0,0 +1,19 @@
+/*
+ * vrrp.h — vrrp_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_VRRP_H
+#define PROTO_AUDIT_VRRP_H
+
+#include <stdint.h>
+
+/* VRRPv3 header (RFC 5798) — 8 bytes minimum */
+struct vrrp_header {
+    uint8_t  vrrp_ver_type;     /* version(4) + type(4) */
+    uint8_t  vrrp_vrid;         /* Virtual Router ID */
+    uint8_t  vrrp_priority;
+    uint8_t  vrrp_count_addrs;  /* count of IP addresses */
+    uint16_t vrrp_rsvd_adver_int; /* reserved(4) + max advertisement interval(12) */
+    uint16_t vrrp_checksum;
+};
+
+#endif /* PROTO_AUDIT_VRRP_H */
