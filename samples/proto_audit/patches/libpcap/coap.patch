--- /dev/null
+++ b/pcap/proto_audit/coap.h
@@ -0,0 +1,20 @@
+/*
+ * coap.h — coap_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_COAP_H
+#define PROTO_AUDIT_COAP_H
+
+#include <stdint.h>
+
+/* CoAP header — 12 bytes minimum */
+struct coap_header {
+    uint8_t  coap_version;
+    uint8_t  coap_code;
+    uint16_t coap_mid;
+    uint32_t coap_token;
+    uint16_t coap_name;
+    uint8_t  coap_end_marker;
+};
+
+#endif /* PROTO_AUDIT_COAP_H */
