--- /dev/null
+++ b/pcap/proto_audit/hsrp.h
@@ -0,0 +1,24 @@
+/*
+ * hsrp.h — hsrp_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_HSRP_H
+#define PROTO_AUDIT_HSRP_H
+
+#include <stdint.h>
+
+/* HSRP header — 20 bytes minimum */
+struct hsrp_header {
+    uint8_t  hsrp_version;
+    uint8_t  hsrp_opcode;
+    uint8_t  hsrp_state;
+    uint8_t  hsrp_hellotime;
+    uint8_t  hsrp_holdtime;
+    uint8_t  hsrp_priority;
+    uint8_t  hsrp_group;
+    uint8_t  hsrp_reserved;
+    uint64_t hsrp_auth_data;
+    uint32_t hsrp_virt_ip;
+};
+
+#endif /* PROTO_AUDIT_HSRP_H */
