--- /dev/null
+++ b/pcap/proto_audit/l2tp.h
@@ -0,0 +1,17 @@
+/*
+ * l2tp.h — l2tp_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_L2TP_H
+#define PROTO_AUDIT_L2TP_H
+
+#include <stdint.h>
+
+/* L2TP header (RFC 2661) — 6 bytes minimum */
+struct l2tp_header {
+    uint16_t l2tp_flags_version;
+    uint16_t l2tp_tunnel_id;
+    uint16_t l2tp_session_id;
+};
+
+#endif /* PROTO_AUDIT_L2TP_H */
