--- /dev/null
+++ b/pcap/proto_audit/iscsi.h
@@ -0,0 +1,27 @@
+/*
+ * iscsi.h — iscsi_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_ISCSI_H
+#define PROTO_AUDIT_ISCSI_H
+
+#include <stdint.h>
+
+/* iSCSI header — 200 bytes minimum */
+struct iscsi_header {
+    uint8_t  iscsi_opcode;
+    uint8_t  iscsi_t;
+    uint8_t  iscsi_versionmax;
+    uint8_t  iscsi_versionmin;
+    uint8_t  iscsi_totalahslength;
+    uint8_t  iscsi_datasegmentlength;
+    uint8_t  iscsi_isid;
+    uint16_t iscsi_tsih;
+    uint32_t iscsi_initiatortasktag;
+    uint16_t iscsi_cid;
+    uint8_t  _pad22[2];
+    uint32_t iscsi_cmdsn;
+    uint32_t iscsi_expstatsn;
+};
+
+#endif /* PROTO_AUDIT_ISCSI_H */
