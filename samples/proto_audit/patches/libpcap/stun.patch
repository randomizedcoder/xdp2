--- /dev/null
+++ b/pcap/proto_audit/stun.h
@@ -0,0 +1,18 @@
+/*
+ * stun.h — stun_header definition for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_STUN_H
+#define PROTO_AUDIT_STUN_H
+
+#include <stdint.h>
+
+/* STUN header (RFC 8489) — 20 bytes */
+struct stun_header {
+    uint16_t stun_type;
+    uint16_t stun_length;
+    uint32_t stun_magic_cookie;      /* 0x2112A442 */
+    uint8_t  stun_transaction_id[12];
+};
+
+#endif /* PROTO_AUDIT_STUN_H */
