+/*
+ * netlink_netfilter.h — netlink_netfilter_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_NETLINK_NETFILTER_H
+#define PROTO_AUDIT_NETLINK_NETFILTER_H
+
+#include <stdint.h>
+
+/* Netlink-netfilter header — 28 bytes minimum */
+struct netlink_netfilter_header {
+    uint8_t  _pad0[4];
+    uint16_t netlink_netfilter_subsys;
+    uint8_t  _pad6[10];
+    uint8_t  netlink_netfilter_family;
+    uint8_t  netlink_netfilter_version;
+    uint16_t netlink_netfilter_res_id;
+};
+
+#endif /* PROTO_AUDIT_NETLINK_NETFILTER_H */
