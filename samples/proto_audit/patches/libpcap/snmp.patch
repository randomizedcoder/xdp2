--- /dev/null
+++ b/pcap/proto_audit/snmp.h
@@ -0,0 +1,25 @@
+/*
+ * snmp.h — snmp_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_SNMP_H
+#define PROTO_AUDIT_SNMP_H
+
+#include <stdint.h>
+
+/* SNMP header — 66 bytes minimum */
+struct snmp_header {
+    uint8_t  _pad0[4];
+    uint8_t  snmp_msgversion;
+    uint8_t  snmp_msgglobaldata_element[17];
+    uint8_t  _pad22[8];
+    uint8_t  snmp_msgauthoritativeengineboots;
+    uint8_t  _pad31[2];
+    uint8_t  snmp_msgauthoritativeenginetime;
+    uint8_t  _pad34[2];
+    uint8_t  snmp_msgusername;
+    uint8_t  _pad41[4];
+    uint8_t  snmp_msgdata[21];
+};
+
+#endif /* PROTO_AUDIT_SNMP_H */
