+/*
+ * tds.h — tds_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_TDS_H
+#define PROTO_AUDIT_TDS_H
+
+#include <stdint.h>
+
+/* Tds header — 190 bytes minimum */
+struct tds_header {
+    uint8_t  tds_type;
+    uint8_t  tds_status;
+    uint16_t tds_length;
+    uint16_t tds_channel;
+    uint8_t  tds_packet_number;
+    uint8_t  tds_window;
+};
+
+#endif /* PROTO_AUDIT_TDS_H */
