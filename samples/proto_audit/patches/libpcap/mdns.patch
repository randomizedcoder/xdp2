--- /dev/null
+++ b/pcap/proto_audit/mdns.h
@@ -0,0 +1,20 @@
+/*
+ * mdns.h — mdns_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_MDNS_H
+#define PROTO_AUDIT_MDNS_H
+
+#include <stdint.h>
+
+/* mDNS header — 40 bytes minimum */
+struct mdns_header {
+    uint16_t mdns_id;
+    uint16_t mdns_flags;
+    uint16_t mdns_queries;
+    uint16_t mdns_answers;
+    uint16_t mdns_auth_rr;
+    uint16_t mdns_add_rr;
+};
+
+#endif /* PROTO_AUDIT_MDNS_H */
