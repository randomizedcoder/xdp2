+/*
+ * mailslot.h — mailslot_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_MAILSLOT_H
+#define PROTO_AUDIT_MAILSLOT_H
+
+#include <stdint.h>
+
+/* Mailslot header — 25 bytes minimum */
+struct mailslot_header {
