+/*
+ * opensafety_udp.h — opensafety_udp_header for proto-audit comparison.
+ */
+
+#ifndef PROTO_AUDIT_OPENSAFETY_UDP_H
+#define PROTO_AUDIT_OPENSAFETY_UDP_H
+
+#include <stdint.h>
+
+/* Opensafety_udp header — 43 bytes minimum */
+struct opensafety_udp_header {
+    uint8_t  opensafety_udp_version;
+    uint8_t  opensafety_udp_type;
+    uint16_t opensafety_udp_counter;
