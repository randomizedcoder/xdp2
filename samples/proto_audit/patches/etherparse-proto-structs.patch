--- a/src/proto_audit.rs	1969-12-31 16:00:00.000000000 -0800
+++ b/src/proto_audit.rs	1969-12-31 16:00:00.000000000 -0800
@@ -0,0 +1,443 @@
+//! Protocol header structs for proto-audit cross-source comparison.
+//!
+//! These structs define wire-accurate protocol header layouts that the
+//! proto-audit etherparse extractor can parse. Each struct's field order,
+//! types, and sizes match the on-wire binary format per the relevant RFC
+//! or standard.
+//!
+//! The etherparse extractor reads `pub field: Type` declarations and
+//! computes bit offsets sequentially. Array fields `[u8; N]` produce
+//! N*8 bits. Types map to bit widths via etherparse.toml.
+
+// ── Tunneling ──
+
+/// GRE header (RFC 2784) — 4 bytes minimum.
+pub struct GreHeader {
+    /// Flags and version (C, K, S, reserved, version).
+    pub flags_version: u16,
+    /// Encapsulated protocol type (EtherType).
+    pub protocol_type: u16,
+}
+
+/// VXLAN header (RFC 7348) — 8 bytes.
+pub struct VxlanHeader {
+    /// Flags (bit 3 = VNI valid).
+    pub flags: u8,
+    /// Reserved.
+    pub reserved1: [u8; 3],
+    /// VXLAN Network Identifier (24 bits).
+    pub vni: [u8; 3],
+    /// Reserved.
+    pub reserved2: u8,
+}
+
+/// Geneve header (RFC 8926) — 8 bytes minimum.
+pub struct GeneveHeader {
+    /// Version (2 bits) + options length (6 bits).
+    pub ver_opt_len: u8,
+    /// OAM (1) + critical (1) + reserved (6).
+    pub flags: u8,
+    /// Encapsulated protocol type (EtherType).
+    pub protocol_type: u16,
+    /// Virtual Network Identifier (24 bits).
+    pub vni: [u8; 3],
+    /// Reserved.
+    pub reserved: u8,
+}
+
+/// MPLS label stack entry (RFC 3032) — 4 bytes.
+pub struct MplsHeader {
+    /// Label (20) + TC (3) + S (1) + TTL (8) = 32 bits.
+    pub label_tc_s_ttl: u32,
+}
+
+/// NVGRE header (RFC 7637) — 8 bytes.
+/// GRE with Key field carrying VSID + FlowID.
+pub struct NvgreHeader {
+    /// GRE flags and version.
+    pub flags_version: u16,
+    /// Protocol type (0x6558 = transparent Ethernet bridging).
+    pub protocol_type: u16,
+    /// Virtual Subnet ID (24 bits).
+    pub vsid: [u8; 3],
+    /// Flow ID.
+    pub flow_id: u8,
+}
+
+/// PPP header (RFC 1661) — 2 bytes (protocol field only).
+pub struct PppHeader {
+    /// PPP protocol number.
+    pub protocol: u16,
+}
+
+/// PPPoE header (RFC 2516) — 6 bytes.
+pub struct PppoeHeader {
+    /// Version (4 bits) + Type (4 bits).
+    pub version_type: u8,
+    /// Code (Discovery or Session).
+    pub code: u8,
+    /// Session ID.
+    pub session_id: u16,
+    /// Payload length.
+    pub length: u16,
+}
+
+/// L2TP header (RFC 2661) — 6 bytes minimum.
+pub struct L2tpHeader {
+    /// Flags and version.
+    pub flags_version: u16,
+    /// Tunnel ID.
+    pub tunnel_id: u16,
+    /// Session ID.
+    pub session_id: u16,
+}
+
+/// ERSPAN Type II header (Cisco) — 8 bytes.
+pub struct ErspanHeader {
+    /// Version (4) + VLAN (12).
+    pub ver_vlan: u16,
+    /// COS (3) + BSO (2) + T (1) + session ID (10).
+    pub cos_bso_t_session: u16,
+    /// Reserved (12) + Index (20) = 32 bits.
+    pub reserved_index: u32,
+}
+
+/// NSH header (RFC 8300) — 8 bytes.
+pub struct NshHeader {
+    /// Version (2) + OAM (1) + unused (1) + TTL (6) + length (6).
+    pub flags_length: u16,
+    /// Reserved (4) + MD Type (4) + Next Protocol (8).
+    pub md_type_next_proto: u16,
+    /// Service Path Identifier (24) + Service Index (8).
+    pub spi_si: u32,
+}
+
+/// HSR tag (IEC 62439-3) — 6 bytes.
+pub struct HsrHeader {
+    /// Path + LSDU size.
+    pub path_lsdu_size: u16,
+    /// Sequence number.
+    pub seq_nr: u16,
+    /// Encapsulated protocol (EtherType).
+    pub ether_type: u16,
+}
+
+/// VXLAN-GPE header (draft-ietf-nvo3-vxlan-gpe) — 8 bytes.
+pub struct VxlanGpeHeader {
+    /// Flags.
+    pub flags: u8,
+    /// Reserved.
+    pub reserved1: u16,
+    /// Next protocol.
+    pub next_protocol: u8,
+    /// Virtual Network Identifier (24 bits).
+    pub vni: [u8; 3],
+    /// Reserved.
+    pub reserved2: u8,
+}
+
+/// WireGuard message header — 4 bytes.
+/// Common prefix for all WireGuard message types.
+pub struct WireGuardHeader {
+    /// Message type (1=init, 2=response, 3=cookie, 4=data).
+    pub msg_type: u8,
+    /// Reserved (3 bytes, must be zero).
+    pub reserved: [u8; 3],
+}
+
+// ── Layer 2 ──
+
+/// IEEE 802.2 LLC header — 3 bytes.
+pub struct LlcHeader {
+    /// Destination Service Access Point.
+    pub dsap: u8,
+    /// Source Service Access Point.
+    pub ssap: u8,
+    /// Control field.
+    pub ctrl: u8,
+}
+
+/// IEEE 802.2 SNAP header — 5 bytes.
+/// Follows LLC header (dsap=0xAA, ssap=0xAA, ctrl=0x03).
+pub struct SnapHeader {
+    /// Organizationally Unique Identifier.
+    pub oui: [u8; 3],
+    /// Protocol ID (EtherType when OUI=0).
+    pub protocol_id: u16,
+}
+
+/// EAPOL header (IEEE 802.1X) — 4 bytes.
+pub struct EapolHeader {
+    /// Protocol version.
+    pub version: u8,
+    /// Packet type.
+    pub packet_type: u8,
+    /// Body length.
+    pub length: u16,
+}
+
+/// STP BPDU header (IEEE 802.1D) — 35 bytes.
+pub struct StpHeader {
+    /// Protocol Identifier (always 0x0000).
+    pub protocol_id: u16,
+    /// Protocol Version Identifier.
+    pub version: u8,
+    /// BPDU Type.
+    pub bpdu_type: u8,
+    /// Topology Change flags.
+    pub flags: u8,
+    /// Root Bridge Identifier.
+    pub root_id: [u8; 8],
+    /// Root Path Cost.
+    pub root_cost: u32,
+    /// Bridge Identifier.
+    pub bridge_id: [u8; 8],
+    /// Port Identifier.
+    pub port_id: u16,
+    /// Message Age (in 256ths of a second).
+    pub message_age: u16,
+    /// Max Age.
+    pub max_age: u16,
+    /// Hello Time.
+    pub hello_time: u16,
+    /// Forward Delay.
+    pub forward_delay: u16,
+}
+
+// ── Layer 3 / Multicast ──
+
+/// IGMP header (RFC 2236) — 8 bytes.
+pub struct IgmpHeader {
+    /// Message type.
+    pub msg_type: u8,
+    /// Max response time.
+    pub max_resp_time: u8,
+    /// Checksum.
+    pub checksum: u16,
+    /// Group address.
+    pub group_address: [u8; 4],
+}
+
+// ── Layer 4 ──
+
+/// SCTP common header (RFC 9260) — 12 bytes.
+pub struct SctpHeader {
+    /// Source port.
+    pub source_port: u16,
+    /// Destination port.
+    pub destination_port: u16,
+    /// Verification tag.
+    pub verification_tag: u32,
+    /// Checksum.
+    pub checksum: u32,
+}
+
+/// DCCP header (RFC 4340) — 12 bytes minimum.
+pub struct DccpHeader {
+    /// Source port.
+    pub source_port: u16,
+    /// Destination port.
+    pub destination_port: u16,
+    /// Data offset (in 32-bit words).
+    pub data_offset: u8,
+    /// CCVal (4 bits) + CsCov (4 bits).
+    pub ccval_cscov: u8,
+    /// Checksum.
+    pub checksum: u16,
+    /// Reserved (3) + Type (4) + X (1).
+    pub res_type_x: u8,
+    /// Sequence number high byte (short sequence).
+    pub seq_hi: u8,
+    /// Sequence number low bytes (short sequence).
+    pub seq_lo: u16,
+}
+
+// ── Security ──
+
+/// ESP header (RFC 4303) — 8 bytes.
+pub struct EspHeader {
+    /// Security Parameters Index.
+    pub spi: u32,
+    /// Sequence number.
+    pub seq_number: u32,
+}
+
+/// AH header (RFC 4302) — 12 bytes minimum.
+pub struct AhHeader {
+    /// Next header (IP protocol number).
+    pub next_header: u8,
+    /// Payload length (in 32-bit words, minus 2).
+    pub payload_len: u8,
+    /// Reserved.
+    pub reserved: u16,
+    /// Security Parameters Index.
+    pub spi: u32,
+    /// Sequence number.
+    pub seq_number: u32,
+}
+
+/// MACsec SecTAG (IEEE 802.1AE) — 6 bytes minimum, padded to 8.
+pub struct MacsecHeader {
+    /// TCI + AN (association number).
+    pub tci_an: u8,
+    /// Short Length.
+    pub short_length: u8,
+    /// Packet Number.
+    pub packet_number: u32,
+    /// Secure Channel Identifier (optional, included for 8B min).
+    pub sci_hi: u16,
+}
+
+// ── Application Binary Protocols ──
+
+/// DNS header (RFC 1035) — 12 bytes.
+pub struct DnsHeader {
+    /// Transaction ID.
+    pub id: u16,
+    /// Flags (QR, Opcode, AA, TC, RD, RA, Z, RCODE).
+    pub flags: u16,
+    /// Question count.
+    pub qd_count: u16,
+    /// Answer count.
+    pub an_count: u16,
+    /// Authority count.
+    pub ns_count: u16,
+    /// Additional count.
+    pub ar_count: u16,
+}
+
+/// NTP header (RFC 5905) — 48 bytes.
+pub struct NtpHeader {
+    /// LI (2) + VN (3) + Mode (3).
+    pub li_vn_mode: u8,
+    /// Stratum.
+    pub stratum: u8,
+    /// Poll interval.
+    pub poll: u8,
+    /// Precision.
+    pub precision: u8,
+    /// Root delay.
+    pub root_delay: u32,
+    /// Root dispersion.
+    pub root_dispersion: u32,
+    /// Reference ID.
+    pub reference_id: u32,
+    /// Reference timestamp.
+    pub reference_ts: [u8; 8],
+    /// Origin timestamp.
+    pub origin_ts: [u8; 8],
+    /// Receive timestamp.
+    pub receive_ts: [u8; 8],
+    /// Transmit timestamp.
+    pub transmit_ts: [u8; 8],
+}
+
+/// RTP header (RFC 3550) — 12 bytes.
+pub struct RtpHeader {
+    /// V (2) + P (1) + X (1) + CC (4).
+    pub flags_cc: u8,
+    /// M (1) + PT (7).
+    pub marker_pt: u8,
+    /// Sequence number.
+    pub sequence_number: u16,
+    /// Timestamp.
+    pub timestamp: u32,
+    /// Synchronization source.
+    pub ssrc: u32,
+}
+
+/// RADIUS header (RFC 2865) — 20 bytes.
+pub struct RadiusHeader {
+    /// Code (Access-Request, etc.).
+    pub code: u8,
+    /// Identifier.
+    pub identifier: u8,
+    /// Total length.
+    pub length: u16,
+    /// Authenticator.
+    pub authenticator: [u8; 16],
+}
+
+/// BFD header (RFC 5880) — 24 bytes.
+pub struct BfdHeader {
+    /// Version (3) + Diag (5).
+    pub ver_diag: u8,
+    /// State (2) + flags (6).
+    pub sta_flags: u8,
+    /// Detect multiplier.
+    pub detect_mult: u8,
+    /// Length.
+    pub length: u8,
+    /// My Discriminator.
+    pub my_discriminator: u32,
+    /// Your Discriminator.
+    pub your_discriminator: u32,
+    /// Desired Min TX Interval.
+    pub min_tx_interval: u32,
+    /// Required Min RX Interval.
+    pub min_rx_interval: u32,
+    /// Required Min Echo RX Interval.
+    pub min_echo_rx_interval: u32,
+}
+
+/// PTP header (IEEE 1588) — 34 bytes.
+pub struct PtpHeader {
+    /// Transport specific (4) + Message type (4).
+    pub transport_msg_type: u8,
+    /// Version PTP (4) + minor version (4).
+    pub version: u8,
+    /// Message length.
+    pub message_length: u16,
+    /// Domain number.
+    pub domain_number: u8,
+    /// Minor SDO ID.
+    pub minor_sdo_id: u8,
+    /// Flags.
+    pub flags: u16,
+    /// Correction field.
+    pub correction: [u8; 8],
+    /// Message type specific.
+    pub msg_type_specific: u32,
+    /// Source port identity.
+    pub source_port_identity: [u8; 10],
+    /// Sequence ID.
+    pub sequence_id: u16,
+    /// Control field.
+    pub control: u8,
+    /// Log message interval.
+    pub log_message_interval: u8,
+}
+
+// ── CAN Bus ──
+
+/// CAN frame header (socketcan) — 16 bytes.
+pub struct CanHeader {
+    /// CAN ID + flags.
+    pub can_id: u32,
+    /// Data length code.
+    pub len: u8,
+    /// Flags.
+    pub flags: u8,
+    /// Reserved.
+    pub reserved: u8,
+    /// Length to DLC.
+    pub len8_dlc: u8,
+    /// Data payload.
+    pub data: [u8; 8],
+}
+
+/// CAN FD frame header (socketcan) — 72 bytes.
+pub struct CanFdHeader {
+    /// CAN ID + flags.
+    pub can_id: u32,
+    /// Data length.
+    pub len: u8,
+    /// Flags (BRS, ESI).
+    pub flags: u8,
+    /// Reserved.
+    pub reserved: u8,
+    /// Length to DLC.
+    pub len8_dlc: u8,
+    /// Data payload (up to 64 bytes).
+    pub data: [u8; 64],
+}
