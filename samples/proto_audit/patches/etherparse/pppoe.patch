+//! PPPoE header (RFC 2516) — 6 bytes.
+
+/// PPPoE header (RFC 2516) — 6 bytes.
+pub struct PppoeHeader {
+    /// Version (must be 1).
+    pub version: Bits4,
+    /// Type (must be 1).
+    pub pppoe_type: Bits4,
+    /// Code (Discovery or Session).
+    pub code: u8,
+    /// Session ID.
+    pub session_id: u16,
+    /// Payload length.
+    pub length: u16,
+}
