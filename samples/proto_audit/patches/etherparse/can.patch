+//! CAN frame header (socketcan) — 16 bytes.
+
+/// CAN frame header (socketcan) — 16 bytes.
+pub struct CanHeader {
+    /// CAN identifier (29 bits for EFF, 11 for SFF).
+    pub can_id: Bits29,
+    /// Error frame flag.
+    pub err_flag: bool,
+    /// Remote transmission request.
+    pub rtr_flag: bool,
+    /// Extended frame format.
+    pub eff_flag: bool,
+    /// Data length code.
+    pub len: u8,
+    /// Flags.
+    pub flags: u8,
+    /// Reserved.
+    pub reserved: u8,
+    /// Length to DLC.
+    pub len8_dlc: u8,
+    /// Data payload.
+    pub data: [u8; 8],
+}
