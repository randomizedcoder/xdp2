+//! VXLAN header (RFC 7348) — 8 bytes.
+
+/// VXLAN header (RFC 7348) — 8 bytes.
+pub struct VxlanHeader {
+    /// Flags (bit 3 = VNI valid).
+    pub flags: u8,
+    /// Reserved.
+    pub reserved1: [u8; 3],
+    /// VXLAN Network Identifier (24 bits).
+    pub vni: [u8; 3],
+    /// Reserved.
+    pub reserved2: u8,
+}
