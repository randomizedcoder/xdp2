+//! CAN FD frame header (socketcan) — 72 bytes.
+
+/// CAN FD frame header (socketcan) — 72 bytes.
+pub struct CanFdHeader {
+    /// CAN identifier (29 bits for EFF, 11 for SFF).
+    pub can_id: Bits29,
+    /// Error frame flag.
+    pub err_flag: bool,
+    /// Remote transmission request.
+    pub rtr_flag: bool,
+    /// Extended frame format.
+    pub eff_flag: bool,
+    /// Data length.
+    pub len: u8,
+    /// Flags (BRS, ESI).
+    pub flags: u8,
+    /// Reserved.
+    pub reserved: u8,
+    /// Length to DLC.
+    pub len8_dlc: u8,
+    /// Data payload (up to 64 bytes).
+    pub data: [u8; 64],
+}
