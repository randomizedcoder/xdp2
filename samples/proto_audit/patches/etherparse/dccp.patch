+//! DCCP header (RFC 4340) — 12 bytes minimum.
+
+/// DCCP header (RFC 4340) — 12 bytes minimum.
+pub struct DccpHeader {
+    /// Source port.
+    pub source_port: u16,
+    /// Destination port.
+    pub destination_port: u16,
+    /// Data offset (in 32-bit words).
+    pub data_offset: u8,
+    /// CCVal.
+    pub ccval: Bits4,
+    /// Checksum coverage.
+    pub cscov: Bits4,
+    /// Checksum.
+    pub checksum: u16,
+    /// Reserved.
+    pub reserved: Bits3,
+    /// DCCP packet type.
+    pub dccp_type: Bits4,
+    /// Extended sequence numbers.
+    pub x: bool,
+    /// Sequence number high byte (short sequence).
+    pub seq_hi: u8,
+    /// Sequence number low bytes (short sequence).
+    pub seq_lo: u16,
+}
