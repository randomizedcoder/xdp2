+//! NSH header (RFC 8300) — 8 bytes.
+
+/// NSH header (RFC 8300) — 8 bytes.
+pub struct NshHeader {
+    /// Version.
+    pub version: Bits2,
+    /// OAM flag.
+    pub oam: bool,
+    /// Unused.
+    pub unused0: bool,
+    /// TTL.
+    pub ttl: Bits6,
+    /// Length (in 4-byte units).
+    pub length: Bits6,
+    /// Unused.
+    pub unused1: Bits4,
+    /// Metadata type.
+    pub md_type: Bits4,
+    /// Next protocol.
+    pub next_protocol: u8,
+    /// Service Path Identifier (24 bits).
+    pub spi: [u8; 3],
+    /// Service Index.
+    pub si: u8,
+}
