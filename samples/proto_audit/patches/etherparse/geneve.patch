+//! Geneve header (RFC 8926) — 8 bytes minimum.
+
+/// Geneve header (RFC 8926) — 8 bytes minimum.
+pub struct GeneveHeader {
+    /// Version.
+    pub version: Bits2,
+    /// Options length (in 4-byte units).
+    pub options_length: Bits6,
+    /// OAM packet.
+    pub oam: bool,
+    /// Critical options present.
+    pub critical: bool,
+    /// Reserved.
+    pub reserved0: Bits6,
+    /// Encapsulated protocol type (EtherType).
+    pub protocol_type: u16,
+    /// Virtual Network Identifier (24 bits).
+    pub vni: [u8; 3],
+    /// Reserved.
+    pub reserved1: u8,
+}
