> /* Single-label MPLS (BoS=1). KEY_MPLS write omitted (bench dissector
>  * does not request it; like the slow path's __skb_flow_dissect_mpls
>  * early-out, both paths then stop without descending -> byte-identical
>  * empty inner). Multi-label stacks defer to slow path. */
> static bool flow_dissect_fast_mpls(const struct sk_buff *skb,
> 				   struct flow_dissector *flow_dissector,
> 				   void *target_container,
> 				   const void *data, int nhoff, int hlen)
> {
> 	const struct s3_mpls_label *hdr;
> 	u32 entry, bos;
> 
> 	(void)skb; (void)flow_dissector; (void)target_container;
> 	if (unlikely(hlen - nhoff < (int)sizeof(*hdr)))
> 		return false;
> 	hdr = (const struct s3_mpls_label *)((const u8 *)data + nhoff);
> 	entry = ntohl(hdr->entry);
> 	bos = (entry & MPLS_LS_S_MASK) >> MPLS_LS_S_SHIFT;
> 	if (!bos)
> 		return false;
> 	return true;
> }
