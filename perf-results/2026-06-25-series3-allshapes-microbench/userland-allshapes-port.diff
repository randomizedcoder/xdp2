> /* PPPoE session + IPv{4,6} inner. KEY_PPPOE write omitted (the userland
>  * flow_keys has no pppoe field and the bench dissector never requests
>  * it; the inner 5-tuple is what is compared byte-for-byte). */
> static bool flow_dissect_fast_pppoe(const struct sk_buff *skb,
> 				    struct flow_dissector *flow_dissector,
> 				    void *target_container,
> 				    const void *data,
> 				    int nhoff, int hlen)
> {
> 	const struct s3_pppoe_ses *hdr;
> 	__be16 inner_eth_proto;
> 	u16 ppp_proto;
> 
> 	if (unlikely(hlen - nhoff < (int)sizeof(*hdr)))
> 		return false;
> 	hdr = (const struct s3_pppoe_ses *)((const u8 *)data + nhoff);
> 	/* is_pppoe_ses_hdr_valid: ver==1, type==1, code==0 */
> 	if (hdr->vertype != 0x11 || hdr->code != 0x00)
> 		return false;
> 
> 	ppp_proto = ntohs(hdr->ppp_proto);
> 	switch (ppp_proto) {
> 	case PPP_IP:   inner_eth_proto = htons(ETH_P_IP);   break;
> 	case PPP_IPV6: inner_eth_proto = htons(ETH_P_IPV6); break;
> 	default:       return false;
> 	}
